# ══ 新用户配置入口：先看这里 ═════════════════════════════════════
# 首次：在项目根目录运行 ./scripts/init_local_config.sh，一次补齐全部模板。
# 手动复制：把 config/templates 整目录复制为 .tcode-local 后，
# 每个文件名还需去掉一次 .example（如 tcode.example.json → tcode.json）。
# 已有 .tcode-local 时请用初始化脚本补齐，不要整目录覆盖。
#
# 【必填 · 聊天】tcode.json 顶部：model 与 provider.<id>.models 的模型 ID
# 要一致；provider.<id>.options 的 baseURLEnv、apiKeyEnv 填环境变量名，不填密钥值。
# 默认示例读取 TCODE_DEMO_BASE_URL、TCODE_DEMO_API_KEY；在启动环境设置真实值。
# 【按需 · 看图 / 向量检索】tcode.json：vision_model、embeddings。
# 【按需 · MCP】服务清单默认都是 {}，不需要部署 TMCP 才能聊天。
# 普通 MCP 添加到 mcp.json：填 url 和所需认证 headers，再设 enabled=true。
# 异步计算按接入方式配置后台目标（不要把任务代理放入执行清单）；
# 第三方异步示例见 config/examples/README.md，涉及文件时再配置 Artifact。
# mcp_job_protocol_only.json 仅用于对应兼容档案；mcp_agent_config.json 管 Agent 可见范围。
# 【按需 · 插件 / 桌面 / 独立主机】分别编辑 plugins.json、desktop.env、mcp_host.env。
# 【高级 · 保留默认】human_review.json、skill_routing.yaml、
# sandbox_runner_tool_policy.json、symphony_route.env；按部署策略审查后再改。
# 真实凭据放环境或密钥系统；不要提交 .tcode-local，也不要在运行 JSON 中加注释。

TCODE_PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TCODE_CONFIG_ROOT="$TCODE_PROJECT_ROOT/.tcode-local"
# 默认读取初始化生成的本机高级配置；文件缺失时使用随版本发布的默认值。
# 常用覆盖项放在本文件的 source 之后；不要直接修改仓库里的公开默认值。
if [[ -f "$(dirname "${BASH_SOURCE[0]}")/symphony_route.env" ]]; then
    source "$(dirname "${BASH_SOURCE[0]}")/symphony_route.env"
else
    source "$TCODE_PROJECT_ROOT/config/templates/symphony_route.env.example"
fi

# ── 按需填写：MCP 配置入口 ────────────────────────────────────────
# 默认路径无需修改；在对应 JSON 填服务地址和启用状态。
TCODE_MCP_CONFIG="$TCODE_CONFIG_ROOT/mcp.json"
TCODE_EXECUTOR_MCP_CONFIG="$TCODE_CONFIG_ROOT/mcp_exec_only.json"
# 默认让 Job Protocol 的实际投递和后台发现使用同一份地址；保留显式部署覆盖。
TMCP_TARGET_SERVER_CONFIG="${TMCP_TARGET_SERVER_CONFIG:-$TCODE_EXECUTOR_MCP_CONFIG}"
# 【启用远端文件传输时填写】默认回退到本机服务；部署时注入真实地址和认证。
TMCP_ARTIFACT_SERVICE_URL="${TMCP_ARTIFACT_SERVICE_URL:-http://127.0.0.1:10120}"

# ── AG-UI Gateway 与 MCP Apps Host ────────────────────────────
# 本地开发默认开启；`${变量名:-1}` 会保留启动命令或进程管理器显式传入的 0/false，
# 因此需要临时关闭时可在启动前覆盖，而不必修改本文件。
#
# TCODE_AGUI_ENABLED 控制 `/api/ag-ui/v1/*` 标准 Agent Gateway。CopilotKit、
# 第三方 AG-UI 客户端以及 `packages/tcode-agui-client` 都依赖该入口；它不会改变
# TCode 自有 WebSocket 前端的行为。
#
# TCODE_MCP_APPS_ENABLED 控制 `/api/mcp-apps/v1/*` 的 MCP App 资源读取和受控
# `tools/call`。它只启用 Host API，不会自动连接 MCP Server；实际远端服务仍由
# `.tcode-local/mcp.json` 的 `enabled`、`url` 和认证请求头决定。
#
# 对公网部署时应先启用 TCode 身份认证、AG-UI API Key/Scope、HTTPS 和访问限流；
# 在这些边界配置完成前，可由部署环境显式设置为 0。
TCODE_AGUI_ENABLED="${TCODE_AGUI_ENABLED:-1}"
TCODE_MCP_APPS_ENABLED="${TCODE_MCP_APPS_ENABLED:-1}"

# ── Harness 运行中切换与有限上下文交接 ─────────────────────────
# 摘要始终由 TCode Provider 生成；失败或超时会自动使用确定性基础摘要，
# 不会阻止 Harness 切换。最近对话最多继承 8 轮，且不会传递原始 Tool/MCP 输出。
TCODE_HARNESS_HANDOFF_MODEL="${TCODE_HARNESS_HANDOFF_MODEL:-deepseek/deepseek-v4-flash}"
TCODE_HARNESS_HANDOFF_TIMEOUT_SECONDS="${TCODE_HARNESS_HANDOFF_TIMEOUT_SECONDS:-10}"
TCODE_HARNESS_HANDOFF_RECENT_ROUNDS="${TCODE_HARNESS_HANDOFF_RECENT_ROUNDS:-8}"

# 仓库内官方 SDK v1 插件由宿主根据精确路径识别，无需重复写入名单。
# 只有经运维单独审核的额外插件才可在这里使用精确名称；默认为空且不支持通配符。
TCODE_PLUGIN_TRUSTED_ALLOWLIST="${TCODE_PLUGIN_TRUSTED_ALLOWLIST:-}"

# 本地 runner 模式：保留 HTTP runner，但不强制生产环境中
# “Web 系统用户不能访问 Docker”的隔离要求。
TCODE_SANDBOX_REQUIRE_RUNNER=false
TCODE_SANDBOX_RUNNER_HOST=127.0.0.1
TCODE_SANDBOX_RUNNER_PORT=19092
TCODE_SANDBOX_RUNNER_URL=http://127.0.0.1:19092
TCODE_SANDBOX_RUNNER_TOKEN_FILE="$TCODE_PROJECT_ROOT/tmp/sandbox-runner/runner.token"
TCODE_SANDBOX_RUNNER_REQUIRE_TOKEN=true
TCODE_SANDBOX_AUTO_CREATE_TOKEN=true
# 本地未知插件也走独立 Docker Worker；不在开发机自动降级成本机进程。
TCODE_PLUGIN_ISOLATION_BACKEND=container
TCODE_PLUGIN_CONTAINER_IMAGE=tcode-plugin-runtime:py312
TCODE_PLUGIN_CONTAINER_USER=65532:65532
TCODE_PLUGIN_RUNNER_ALLOWED_PLUGIN_ROOTS="$TCODE_PROJECT_ROOT/plugins"
# Sandbox Runner 使用 -d 后的进程日志和 PID；前台模式日志直接输出到当前终端。
TCODE_SANDBOX_RUNNER_SERVICE_LOG_DIR="${TCODE_SANDBOX_RUNNER_SERVICE_LOG_DIR:-$TCODE_PROJECT_ROOT/runs/sandbox_runner}"
TCODE_SANDBOX_RUNNER_SERVICE_PID_DIR="${TCODE_SANDBOX_RUNNER_SERVICE_PID_DIR:-$TCODE_PROJECT_ROOT/runs/sandbox_runner}"
TCODE_BROWSER_REQUIRE_RUNNER=true

# ── TMCP Artifact 与服务隔离（当前双主机部署）───────────────────
# 这份 local.env 用于本地 TCode/Agent + Job Protocol。
# Artifact 与领域 MCP 可以位于另一台主机；对应地址只写入本机私有配置。
PYTHON_BIN="${PYTHON_BIN:-python3}"
TMCP_ROOT="$TCODE_PROJECT_ROOT/../tmcp"
TMCP_LOCAL_TRUSTED="${TMCP_LOCAL_TRUSTED:-true}"
# 仅在受控单机或可信内网中启用；跨主机部署必须改为令牌认证。
# 未来改为 false 时，Artifact 与 Job Protocol HTTP API 共用此 Token。
TMCP_SERVICE_API_TOKEN="${TMCP_SERVICE_API_TOKEN:-}"
TMCP_AUTH_MODE="${TMCP_AUTH_MODE:-compat}"
TMCP_COMPUTE_SUBMISSION_POLICY="${TMCP_COMPUTE_SUBMISSION_POLICY:-direct}"
TMCP_REQUIRE_ARTIFACT_REFS="${TMCP_REQUIRE_ARTIFACT_REFS:-true}"

# 本地不启动 Artifact，HOST 仅作本地安全回退；远端监听地址由 mcp_host.env 设为 0.0.0.0。
TMCP_ARTIFACT_HOST="${TMCP_ARTIFACT_HOST:-127.0.0.1}"
TMCP_ARTIFACT_PORT="${TMCP_ARTIFACT_PORT:-10120}"
TMCP_ARTIFACT_DATA_ROOT="${TMCP_ARTIFACT_DATA_ROOT:-$TMCP_ROOT/var/artifacts}"
TMCP_ARTIFACT_DATABASE="${TMCP_ARTIFACT_DATABASE:-$TMCP_ARTIFACT_DATA_ROOT/metadata.sqlite3}"
TMCP_ARTIFACT_RUN_ROOT="${TMCP_ARTIFACT_RUN_ROOT:-$TMCP_ROOT/var/artifact-runs}"
TMCP_ARTIFACT_LOCAL_REGISTER_ROOTS="${TMCP_ARTIFACT_LOCAL_REGISTER_ROOTS:-$TMCP_ARTIFACT_RUN_ROOT}"
TMCP_ARTIFACT_ALLOW_LOCAL_REGISTER="${TMCP_ARTIFACT_ALLOW_LOCAL_REGISTER:-true}"
# 跨主机部署时将 TMCP_LOCAL_TRUSTED=false，并从密钥系统注入此值。
TMCP_ARTIFACT_API_TOKEN="${TMCP_ARTIFACT_API_TOKEN:-}"

# 默认单文件 500 MiB、Bundle 5 GiB/10000 文件/32 层；均可在启动前覆盖。
TMCP_ARTIFACT_MAX_FILE_BYTES="${TMCP_ARTIFACT_MAX_FILE_BYTES:-524288000}"
TMCP_ARTIFACT_MAX_BUNDLE_BYTES="${TMCP_ARTIFACT_MAX_BUNDLE_BYTES:-5368709120}"
TMCP_ARTIFACT_MAX_BUNDLE_FILES="${TMCP_ARTIFACT_MAX_BUNDLE_FILES:-10000}"
TMCP_ARTIFACT_MAX_TREE_DEPTH="${TMCP_ARTIFACT_MAX_TREE_DEPTH:-32}"
TMCP_ARTIFACT_CHUNK_BYTES="${TMCP_ARTIFACT_CHUNK_BYTES:-8388608}"
TMCP_ARTIFACT_MAX_CONCURRENT_UPLOADS="${TMCP_ARTIFACT_MAX_CONCURRENT_UPLOADS:-5}"
TMCP_ARTIFACT_INCOMPLETE_TTL_HOURS="${TMCP_ARTIFACT_INCOMPLETE_TTL_HOURS:-24}"
TMCP_ARTIFACT_UNREFERENCED_TTL_DAYS="${TMCP_ARTIFACT_UNREFERENCED_TTL_DAYS:-7}"
TMCP_ARTIFACT_REFERENCED_TTL_DAYS="${TMCP_ARTIFACT_REFERENCED_TTL_DAYS:-90}"
TMCP_ARTIFACT_SOFT_DELETE_DAYS="${TMCP_ARTIFACT_SOFT_DELETE_DAYS:-7}"
TMCP_ARTIFACT_PROXY_TIMEOUT_SECONDS="${TMCP_ARTIFACT_PROXY_TIMEOUT_SECONDS:-900}"

# Agent 收集远端 output_bundle 时的本地落盘上限；默认与 Artifact 服务上限一致。
# 下载逐文件校验 size/sha256，并保留 Bundle 相对目录结构。
TCODE_ARTIFACT_MATERIALIZE_MAX_FILE_BYTES="${TCODE_ARTIFACT_MATERIALIZE_MAX_FILE_BYTES:-$TMCP_ARTIFACT_MAX_FILE_BYTES}"
TCODE_ARTIFACT_MATERIALIZE_MAX_BYTES="${TCODE_ARTIFACT_MATERIALIZE_MAX_BYTES:-$TMCP_ARTIFACT_MAX_BUNDLE_BYTES}"
TCODE_ARTIFACT_MATERIALIZE_MAX_FILES="${TCODE_ARTIFACT_MATERIALIZE_MAX_FILES:-$TMCP_ARTIFACT_MAX_BUNDLE_FILES}"
TCODE_ARTIFACT_MATERIALIZE_MAX_TREE_DEPTH="${TCODE_ARTIFACT_MATERIALIZE_MAX_TREE_DEPTH:-$TMCP_ARTIFACT_MAX_TREE_DEPTH}"
TCODE_ARTIFACT_DOWNLOAD_TIMEOUT_SECONDS="${TCODE_ARTIFACT_DOWNLOAD_TIMEOUT_SECONDS:-$TMCP_ARTIFACT_PROXY_TIMEOUT_SECONDS}"

# Job Protocol 在本地运行，只使用自身 SQLite 和任务目录，不读取 Agent Workspace。
TMCP_JOB_DATA_ROOT="${TMCP_JOB_DATA_ROOT:-$TMCP_ROOT/var/job-protocol}"
TMCP_JOB_PROTOCOL_HOST="${TMCP_JOB_PROTOCOL_HOST:-127.0.0.1}"
TMCP_JOB_PROTOCOL_PORT="${TMCP_JOB_PROTOCOL_PORT:-10121}"
TMCP_JOB_PROTOCOL_API_BASE="${TMCP_JOB_PROTOCOL_API_BASE:-http://127.0.0.1:10121}"
TMCP_JOB_PROTOCOL_API_TOKEN="${TMCP_JOB_PROTOCOL_API_TOKEN:-$TMCP_SERVICE_API_TOKEN}"

# TCODE_ENTERPRISE_MODE=0
# TCODE_AUTH_REQUIRED=0

# 每个用户最多允许拥有的有效 Workspace 数量；已软删除的 Workspace 不计入，恢复时会重新校验额度。
# 必须设置为大于 0 的整数，修改后需要重启 Web 服务；未设置或无效时使用安全默认值 5。
TCODE_MAX_WORKSPACES_PER_USER="${TCODE_MAX_WORKSPACES_PER_USER:-5}"

# 普通容器默认用户，格式为 UID:GID；应匹配本机 workspace 的可写权限。
TCODE_SANDBOX_USER=1000:1000
# Runner 允许的容器用户精确列表，英文逗号分隔。普通用户和 root profile 使用的 0:0 都必须列出。
TCODE_SANDBOX_RUNNER_ALLOWED_USERS=1000:1000
# 以下两个开关只是 Runner 的能力上限，不会单独授予 root；实际 root 还要通过认证 user_id 白名单和 profile 校验。
# true/false：是否允许任何经过后续校验的容器使用 root 用户。
TCODE_SANDBOX_RUNNER_ALLOW_CONTAINER_ROOT=false
# true/false：是否允许任何经过后续校验的容器使用可写根文件系统。
TCODE_SANDBOX_RUNNER_ALLOW_WRITABLE_ROOT=false
# root Runtime 总开关。true：启用按认证 user_id 路由；false：所有用户均使用普通非 root Runtime。
TCODE_SANDBOX_ROOT_RUNTIME_ENABLED=false

# 容器 root 白名单，填写 /api/auth/me 返回的 user.user_id，多个 ID 使用英文逗号分隔。
# 当前只授权 bootstrap 管理员 admin。增加用户示例：admin,user-001,user-002
# 该白名单只控制容器 root 权限，不会授予后台 admin/owner 角色。
TCODE_SANDBOX_ROOT_RUNTIME_USER_IDS=

# 白名单用户最终使用的 sandbox profile；必须对应 tcode.json 中 persistent + 0:0 + read_only=false 的 profile。
TCODE_SANDBOX_ROOT_RUNTIME_PROFILE=workspace_root_runtime

# 可自动升级的普通 profile 名称列表，英文逗号分隔；名称必须存在于 tcode.json。
# 当前建议值：workspace_runtime、executor、networked、default。不要加入 browser、blast_tools 或 MCP 专用 profile。
TCODE_SANDBOX_ROOT_RUNTIME_BASE_PROFILES=workspace_runtime,executor,networked,default
TCODE_SANDBOX_WORKSPACE_ROOT="$TCODE_PROJECT_ROOT/workdirs"
TCODE_SANDBOX_RUNNER_WORKSPACE_ROOT="$TCODE_PROJECT_ROOT/workdirs"

# 本地开发：统一放开技能父目录，避免每新增一个插件都要单独追加白名单。
TCODE_SANDBOX_RUNNER_ALLOWED_MOUNT_ROOTS="$TCODE_PROJECT_ROOT/.claude/skills,$TCODE_PROJECT_ROOT/plugins"

# Runner 允许接收的工具。skill_run 是 Skill action 的统一执行入口；
# plugin:* 允许插件运行时使用带命名空间的工具名。
TCODE_SANDBOX_RUNNER_ALLOWED_TOOLS=bash,exec,browser,skill_run,plugin_runtime,plugin_network,plugin:*

# 按“工具 + capability”限制可使用的镜像和网络，防止 Web 端伪造沙盒配置。
TCODE_SANDBOX_RUNNER_TOOL_POLICY_FILE="$TCODE_CONFIG_ROOT/sandbox_runner_tool_policy.json"

# Browser Agent 只能通过容器访问当前 workspace；宿主机外部文件必须显式导入。
TCODE_WORKSPACE_IO_ALLOW_EXTERNAL_READ=false
TCODE_WORKSPACE_IO_ALLOW_EXTERNAL_WRITE=false
# 本地开发也保持与生产一致：运行记录和密钥对 Agent 隐藏，平台配置只读。
TCODE_SANDBOX_WORKSPACE_HIDDEN_PATHS=.tcode,.tcode-local,.env,config/local.env,config/sandbox_production.env,.tcode-local/mcp_host.env
TCODE_SANDBOX_WORKSPACE_READ_ONLY_PATHS=.git,tcode.json,plugins.json,mcp.json,sandbox_runner_tool_policy.json,mcp_job_protocol_only.json
# 该目录由本地 Sandbox Runner 使用，位置在用户 workdirs 之外。
TCODE_SANDBOX_WORKSPACE_MASK_ROOT="$TCODE_PROJECT_ROOT/tmp/sandbox-runner/workspace-masks"

# 服务器若启用 BLAST 等固定只读资源，在这里设置清单路径，并把对应宿主机目录
# 追加到上面的 TCODE_SANDBOX_RUNNER_ALLOWED_MOUNT_ROOTS。
# TCODE_SANDBOX_STATIC_RESOURCES_FILE=/etc/tcode/sandbox-static-resources.json

# 本地开发时，将 runner 管理的运行状态保存在项目临时目录中。
TCODE_SANDBOX_SNAPSHOT_ROOT="$TCODE_PROJECT_ROOT/tmp/sandbox-runner/snapshots"
TCODE_SANDBOX_CONFLICT_ROOT="$TCODE_PROJECT_ROOT/tmp/sandbox-runner/conflicts"
TCODE_SANDBOX_JOB_LOG_ROOT="$TCODE_PROJECT_ROOT/tmp/sandbox-runner/logs"
TCODE_SANDBOX_RUNNER_STATE_FILE="$TCODE_PROJECT_ROOT/tmp/sandbox-runner/jobs.json"
# 常驻 Runtime 的 SQLite Registry；Runner 重启后依靠它找回容器，文件权限会收紧为 0600。
TCODE_SANDBOX_RUNTIME_STATE_FILE="$TCODE_PROJECT_ROOT/tmp/sandbox-runner/runtimes.sqlite"
# 大于 0：空闲达到该秒数后 stop；0：不因空闲自动 stop。
TCODE_SANDBOX_RUNTIME_IDLE_STOP_SECONDS=3600
# 大于 0：stop 达到该秒数后删除容器但保留 Runtime HOME；604800 等于 7 天；0 表示永不自动删除。
TCODE_SANDBOX_RUNTIME_RETENTION_SECONDS=604800

# 本地 runsc 网络无法解析 browser 沙盒使用的出口代理网络别名，
# 因此本地开发使用 Docker 默认 runtime。此模式的隔离强度低于生产 runsc，尤其不要给不可信外部用户 root 白名单。
TCODE_SANDBOX_BACKEND=docker
TCODE_SANDBOX_DOCKER_RUNTIME=
TCODE_SANDBOX_RUNNER_REQUIRED_RUNTIME=

# ── Paper Wiki 同租户只读共享 ────────────────────────────────────
# 以下配置都可以不写；不配置时使用代码中的安全默认值。
#
# Wiki 共享授权数据库。这里只保存 tenant_id/user_id/workspace_id、授权范围和审计事件，
# 不保存绝对 Workspace 路径，也不会复制 Wiki 文件。
# 留空：使用 <TCODE_WORKDIR>/.tcode/wiki_shares.sqlite3。
# 生产示例：TCODE_WIKI_SHARES_DB=/var/lib/tcode/wiki_shares.sqlite3
TCODE_WIKI_SHARES_DB="${TCODE_WIKI_SHARES_DB:-}"

# 受信任外部 Agent 调用 /api/paper-wiki/service/* 时使用的固定 Token。
# 留空或少于 24 个字符：服务账号接口保持关闭；Web 登录用户不受影响。
# 生产环境必须从密钥系统注入至少 32 字节随机值，不要把真实 Token 提交到仓库。
# 请求可使用 X-Wiki-Service-Token，也可使用 Authorization: Bearer <token>。
# 示例（仅说明格式）：TCODE_WIKI_SERVICE_TOKEN=replace-with-32-byte-random-secret
TCODE_WIKI_SERVICE_TOKEN="${TCODE_WIKI_SERVICE_TOKEN:-}"

# 一次“我的 Wiki + 全部可访问共享 Wiki”检索最多展开的共享来源数。
# 默认 24，允许 1–64；超过上限的来源不会在本次请求展开，以避免 MVP 阶段卡死。
TCODE_WIKI_SEARCH_MAX_SOURCES="${TCODE_WIKI_SEARCH_MAX_SOURCES:-24}"

# 同时查询多少个共享 Wiki 来源。默认 4，允许 1–12。
TCODE_WIKI_SEARCH_CONCURRENCY="${TCODE_WIKI_SEARCH_CONCURRENCY:-4}"

# 单个来源的超时秒数。默认 1.5，允许 0.2–5；超时来源会被跳过并返回 partial=true。
TCODE_WIKI_SEARCH_SOURCE_TIMEOUT_SECONDS="${TCODE_WIKI_SEARCH_SOURCE_TIMEOUT_SECONDS:-1.5}"

# 一次共享来源扇出查询的总等待秒数。默认 3，允许 0.5–10。
# 该上限不包含当前用户自己的 Wiki 查询时间。
TCODE_WIKI_SEARCH_TOTAL_TIMEOUT_SECONDS="${TCODE_WIKI_SEARCH_TOTAL_TIMEOUT_SECONDS:-3}"

# ── 证据账本检索 ───────────────────────────────────────────────
# 关键词与全库语义索引分别召回有限候选，再融合排序；没有语义索引时保留关键词检索。
# 默认每路 256，允许 64–2048；数值越大，召回范围越广，但内存和耗时也越高。
# 大型旧账本的首次索引回填进入后台，状态会明确提示历史检索覆盖尚不完整。
TCODE_EVIDENCE_SEARCH_CANDIDATES="${TCODE_EVIDENCE_SEARCH_CANDIDATES:-256}"
# 证据索引自动在后台分批维护；设为 0 时仅通过 CLI 手动执行，不影响已有关键词索引。
TCODE_EVIDENCE_BACKGROUND_INDEX="${TCODE_EVIDENCE_BACKGROUND_INDEX:-1}"
# 每批记录数，限制为 10 到 500；调小可缩短单次数据库写锁时间。
TCODE_EVIDENCE_INDEX_BATCH_SIZE="${TCODE_EVIDENCE_INDEX_BATCH_SIZE:-100}"
# 全库语义召回开关；必须同时启用现有 embeddings 配置并安装 FAISS。
# 哈希回退向量不视为真正语义模型，未配置时明确退回关键词检索。
TCODE_EVIDENCE_SEMANTIC_SEARCH="${TCODE_EVIDENCE_SEMANTIC_SEARCH:-1}"
# 语义召回最低余弦相似度；不同模型的分数分布不同，可按真实检索结果调整。
TCODE_EVIDENCE_SEMANTIC_MIN_SCORE="${TCODE_EVIDENCE_SEMANTIC_MIN_SCORE:-0.25}"
# 单条证据每次最多检查的来源文件数，避免点击详情时扫描过多文件。
TCODE_EVIDENCE_ASSET_CHECK_LIMIT="${TCODE_EVIDENCE_ASSET_CHECK_LIMIT:-100}"

# ── 第二阶段：执行容量、引导队列与遥测反压 ──────────────────────
