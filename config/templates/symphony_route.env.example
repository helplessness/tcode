# TCode 公共基础配置模板，复制为 .tcode-local/symphony_route.env。
# 本地 local.env 会继承复制后的同目录文件；生产配置也应与其部署在同一目录。
# 【高级 · 默认不改】只聊天不需要编辑本文件。
# 【启用异步目标时必查】在本文件搜索 SYMPHONY_ROUTED_MCP_SERVERS 和
# TCODE_BRIDGE_ALLOWED_SERVERS；后者非空时会进一步收紧领取范围。
# 名单允许不代表服务已启用，实际服务地址及 enabled 仍由 mcp_exec_only.json 管理。

# ── 按需调整：异步任务领取 ─────────────────────────────────────────
# Bridge 只领取执行配置中已启用且非 direct 的目标。
SYMPHONY_ROUTED_MCP_SERVERS=simulation-mcp,boltz-mcp,gnina-mcp,ligandmpnn-mcp,placer-mcp,plip-mcp,rfdiffusion-mcp,evolvepro-mcp,mutation-scoring-mcp,homology-mcp,pythia-mcp,foldx-mcp
# 可选：进一步收紧领取范围。留空时沿用上面的路由名单与执行配置；
# 若路由名单也留空，则以执行配置中已启用的异步服务为准。
TCODE_BRIDGE_ALLOWED_SERVERS=

# 通用值格式：
# - 布尔值：true、1、yes、on 表示开启；false、0、no、off 表示关闭。
# - 列表值：多个值使用英文逗号分隔，逗号前后不要添加多余空格。
# - 时间值：未特别说明时均以秒为单位。
# - 路径值：建议使用绝对路径，避免启动目录不同导致解析结果变化。

# ── 基础路径与通用设置 ──────────────────────────────────────────

# 启动脚本会根据 --workdir 或项目目录设置 TCODE_WORKDIR。
# 如需强制覆盖，可在启动前显式 export TCODE_WORKDIR=/abs/workdir。
# 外层等待子 Agent 的时间必须长于子 Agent 单轮和论文入库工具，避免多层超时互相抢先。
TCODE_SUBAGENT_TOOL_TIMEOUT_SECONDS=4200
# 子 Agent 单轮最大执行时间；允许文献库管理员等待一次完整的 PDF 入库事务。
TCODE_SUBAGENT_TURN_TIMEOUT_SECONDS=3900
# 单篇 PDF 完整入库事务的最大执行时间；超时后会终止工作进程并检查事务是否已经提交。
TCODE_PAPER_LIBRARY_INGEST_TIMEOUT_SECONDS=3600
# 入库工作进程的内部超时；必须短于上面的工具总超时，为终止、回滚和结果确认预留时间。
TCODE_PAPER_LIBRARY_WORKER_TIMEOUT_SECONDS=3300
# read 采用分页返回；达到行数或字符上限后立即停止，不扫描文件尾部。
TCODE_READ_DEFAULT_LIMIT_LINES=2000
TCODE_READ_MAX_OUTPUT_CHARS=80000
TCODE_READ_LARGE_FILE_BYTES=5242880
TCODE_READ_TIMEOUT_SECONDS=30
# true：首次默认读取前执行固定头尾样本预检；false：仅使用 Read 自身分页上限。
TCODE_FILE_PREFLIGHT_ENABLED=true
# 达到此体积时，首次默认读取自动切换成更小的大文件样本。
TCODE_FILE_PREFLIGHT_THRESHOLD_BYTES=5242880
# 预检最多读取的头部、尾部字节数和返回模型的预览字符数；不会扫描整个文件。
TCODE_FILE_PREFLIGHT_HEAD_BYTES=16384
TCODE_FILE_PREFLIGHT_TAIL_BYTES=4096
TCODE_FILE_PREFLIGHT_PREVIEW_CHARS=4096
# 大文件首次默认读取最多返回的行数和字符数；显式游标分页仍受全局 Read 上限保护。
TCODE_READ_LARGE_INITIAL_LINES=100
TCODE_READ_LARGE_INITIAL_CHARS=12000
# Bash/Exec 在进程内最多保留的头尾输出，超出部分继续排空但不再占用内存。
TCODE_PROCESS_CAPTURE_MAX_CHARS=131072
# ProcessRuntime 跨轮询累计保存的输出上限，防止重复沙箱快照放大会话状态文件。
TCODE_MANAGED_PROCESS_OUTPUT_MAX_CHARS=1000000
# 任意工具结果在写入会话、审计日志和前端事件前的宿主级硬上限。
TCODE_TOOL_RESULT_MAX_CHARS=120000
# 单条工具结果进入下一次模型请求前的最后一道字符上限。
TCODE_LLM_TOOL_RESULT_MAX_CHARS=40000

# ── 可逆上下文压缩 ──────────────────────────────────────────────

# 压缩功能总开关：
# - true：允许按下面的 MODE 运行压缩功能；并不等于已经实际启用压缩。
# - false：强制关闭压缩，忽略 MODE、工具列表及其他压缩参数，用于紧急回退。
TCODE_CONTEXT_COMPRESSION_ENABLED=true
# 运行模式：
# - off：完全关闭，不评估、不保存 Capsule、不改变模型输入。
# - shadow：分析压缩候选并记录无正文指标，但不保存原文、不开放 context_expand、不改变模型输入。
# - enforce：对白名单工具保存原文并向模型发送压缩视图，同时开放 context_expand 按需回取。
# 当前保持 off，完成真实输出观察和质量核对前不要直接切换到 enforce。
TCODE_CONTEXT_COMPRESSION_MODE=off
# 允许参与的工具 ID glob，多个值用英文逗号分隔，例如 search,mcp_paper-*：
# - Shadow + 空值：观察全部当前及未来新增工具。
# - Shadow + 非空：只观察匹配项。
# - Enforce + 空值：拒绝全部工具，不会实际压缩。
# - Enforce + 非空：只压缩匹配项；这是 Enforce 的显式安全白名单。
TCODE_CONTEXT_COMPRESSION_TOOLS=
# 拒绝参与的工具 ID glob，多个值用英文逗号分隔，例如 bash,mcp_sensitive-*：
# - 空值：没有额外拒绝项。
# - 非空：匹配项在 Shadow 和 Enforce 中都直接跳过；拒绝规则优先于允许规则。
TCODE_CONTEXT_COMPRESSION_DENY_TOOLS=
# 触发候选分析的最小估算 token 数，按 1 token≈4 字符换算：
# - 有效范围：100～100000；超出范围会自动限制到边界值。
# - 值越小覆盖结果越多但增加计算开销；值越大则只处理更大的输出。
TCODE_CONTEXT_COMPRESSION_MIN_TOKENS=2000
# 单条候选原文允许分析或保存的最大 UTF-8 字节数：
# - 有效范围：1000～10000000；超出范围会自动限制到边界值。
# - 结果超过该值时不压缩、不保存 Capsule，直接沿用原路径。
TCODE_CONTEXT_COMPRESSION_MAX_BYTES=2000000
# 单次确定性提取的处理时间预算，单位为毫秒：
# - 有效范围：1～1000；超出范围会自动限制到边界值。
# - 超时或提取失败时直接沿用原路径，不影响正常工具结果。
TCODE_CONTEXT_COMPRESSION_MAX_LATENCY_MS=50
# Enforce 原文 Capsule 的保留时间，单位为秒：
# - 有效范围：60～2592000（1 分钟～30 天）；超出范围会自动限制到边界值。
# - 到期后原文不可回取；604800 表示 7 天。
TCODE_CONTEXT_CAPSULE_TTL_SECONDS=604800
# 每个 Tenant/User/Workspace/Session Owner 的 Capsule 原文字节配额：
# - 有效范围：10000～512000000；超出范围会自动限制到边界值。
# - 达到配额后新的原文不再保存，并安全退回未压缩路径；64000000 约为 64 MB。
TCODE_CONTEXT_CAPSULE_QUOTA_BYTES=64000000
# 同一轮最多允许 context_expand 回取 Capsule 的次数：
# - 有效范围：1～20；超出范围会自动限制到边界值。
# - 达到次数后拒绝继续回取，避免模型循环展开和上下文再次膨胀。
TCODE_CONTEXT_EXPAND_MAX_CALLS_PER_TURN=4

# 所有 Turn 先做验证规划；V1-V3 任务进入正式验收，V0 只标记为无需验证。
TCODE_OUTCOME_GUARD=1
# 语义验收复用当前会话模型。复杂科学 JSON 在慢模型上可能超过旧的 60 秒默认值。
TCODE_OUTCOME_VALIDATOR_TIMEOUT_SECONDS=180
# 复杂自由文本任务由独立规划调用补全自然语言成功条件；宿主规则提供不可降低的等级下限。
TCODE_OUTCOME_INTENT_PLANNER_ENABLED=1
TCODE_OUTCOME_PLANNER_TIMEOUT_SECONDS=20
# 运行中消息由独立 Revision Agent 结合当前 Contract 和最近对话做语义判断；
# 低置信度时不改 Contract、不自动取消，交回对话确认。
TCODE_OUTCOME_REVISION_PLANNER_ENABLED=1
TCODE_OUTCOME_REVISION_TIMEOUT_SECONDS=12
# 前端只接收“已验证/未验证/部分完成 + 置信度”的极简投影。
TCODE_EXPOSE_OUTCOME_VALIDATION=1
# Outcome v2 使用宿主确定性 Verifier 做强制 Criterion 裁决。
TCODE_DETERMINISTIC_VERIFIER_ENABLED=1
# Proof Pack 保留在后端按需开启，不向普通用户暴露详细证据链。
TCODE_PROOF_PACK_ENABLED=0
# 单个 Artifact 执行 SHA-256 完整性验证时允许读取的最大字节数，默认 512 MiB。
TCODE_OUTCOME_ARTIFACT_HASH_MAX_BYTES=536870912
# 子代理/编排器在整理大 JSON、长报告时的最终回答模型超时。
# 之前默认 180 秒，文献全量抽取读完 evidence 后容易在最后综合阶段超时。
TCODE_FINAL_RESPONSE_LLM_TIMEOUT_SECONDS=600
# 将智能体实际运行的工作区与读取配置的根目录分离。
# 例如，智能体可以在 /srv/tcode/workspaces/ws-smoke 中运行，
# 同时继续从 tcode 项目目录读取 tcode.json、plugins.json 和 mcp.json。
# 启动脚本默认将其指向当前 tcode 项目目录。
# 留空：由启动脚本自动设置；填写路径：强制使用指定的配置根目录。
# 配置示例：TCODE_CONFIG_ROOT=/srv/tcode/tcode

# 获取工具定义时的超时时间，单位为秒。
TCODE_TOOL_DEFINITIONS_TIMEOUT_SECONDS=120

# ── MCP 与 Symphony 路由 ────────────────────────────────────────

# 本机不运行 Symphony；MCP 调用不得投递到 Symphony 队列。
# false：计算型 MCP 由 Job Protocol 创建任务，再交给本机 Bridge worker 执行。
SYMPHONY_ROUTE_ON_MCP_TOOL=false

# 允许直接调用的 MCP 服务。文献检索类 MCP 需要按真实协议调用；
# simple-demo-mcp 只提供无业务副作用的诊断工具，直连可验证真实 MCP 终态，
# 避免把 echo/sleep 误当成计算任务送入 Symphony 队列。
SYMPHONY_DIRECT_MCP_SERVERS=job-protocol-mcp,paper-search-mcp,paper-download-mcp,simple-demo-mcp

# 绝不发送到 Symphony 队列的 MCP 服务。
# job-protocol-mcp 必须保留在此处，以避免任务被递归加入队列。
SYMPHONY_NEVER_ROUTE_MCP_SERVERS=job-protocol-mcp,paper-search-mcp,paper-download-mcp,simple-demo-mcp

# 是否强制执行直连白名单。
# 开启后，不在 SYMPHONY_DIRECT_MCP_SERVERS 中的服务必须通过 Symphony 执行。
# Bridge 单轨下不再用 Symphony 直连白名单反向强制路由。
SYMPHONY_ENFORCE_DIRECT_WHITELIST=true

# 普通启动与桌面共用；仅允许执行配置中已启用的目标，名单本身不启用服务。
TCODE_LAZY_ARTIFACT_MCP_SERVERS="${TCODE_LAZY_ARTIFACT_MCP_SERVERS:-simulation-mcp,boltz-mcp,gnina-mcp,ligandmpnn-mcp,placer-mcp,plip-mcp,rfdiffusion-mcp,evolvepro-mcp,mutation-scoring-mcp,homology-mcp,pythia-mcp,foldx-mcp}"
TCODE_PROTEIN_RUN_ASYNC_SERVERS="${TCODE_PROTEIN_RUN_ASYNC_SERVERS:-simulation-mcp,boltz-mcp,gnina-mcp,ligandmpnn-mcp,placer-mcp,plip-mcp,rfdiffusion-mcp,evolvepro-mcp,mutation-scoring-mcp,homology-mcp,pythia-mcp,foldx-mcp}"

# mutation-scoring 服务使用启动脚本统一的 PYTHON_BIN，解释器需包含 GPU 模型依赖和 fastmcp。
# MUTATION_SCORING_MODEL_CACHE_SIZE=1
# MUTATION_SCORING_MAX_SEQUENCE_LENGTH=1022

# Symphony 刷新接口地址。
SYMPHONY_API_BASE=http://127.0.0.1:7890

# submit_job 先创建本地受理任务，再由 Bridge worker 通过 Job Protocol 投递。
# 仅使用 Bridge 单轨，不依赖 Symphony 进程或共享文件。
TCODE_PROXY_SUBMIT_MODE=bridge

# 【按需 · MCP 兼容档案】默认留空，普通启动读取 mcp.json。
# 只有需要单独维护前台兼容清单时，才设为 job-protocol-only，改读 mcp_job_protocol_only.json。
TCODE_MCP_PROFILE="${TCODE_MCP_PROFILE:-}"

# 任务执行子进程使用的 MCP 配置文件。
# 该文件应包含实际执行工具的 MCP，并排除 job-protocol-mcp，避免递归提交。
TCODE_EXECUTOR_MCP_CONFIG=mcp_exec_only.json

# MCP 工具执行器失败后的最大重试次数。
# 0：不重试；正整数：最多重试对应次数；当前代码默认值为 3。
MCP_TOOL_RUNNER_MAX_RETRIES=3

# 提交计算型 MCP 前，通过 job-protocol-mcp 的轻量契约接口校验目标参数。
# 校验服务不可用或参数不合法时不创建异步任务，避免昂贵任务延迟失败。
TCODE_TARGET_CONTRACT_VALIDATION=true

# ── 异步任务与工作节点 ──────────────────────────────────────────

# 共享任务跟踪器接口地址。
TCODE_TRACKER_API_BASE=http://127.0.0.1:5554

# 异步 MCP 统一交给本机 Bridge worker，由它调用 Job Protocol。
# 该单轨形态不启动 Symphony sidecar。
TCODE_ASYNC_EXECUTION_MODE=bridge

# 可选：共享任务跟踪器的 SQLite 文件路径。
# 留空：使用 tcode/tmp/shared_tracker.sqlite；填写路径：使用指定数据库文件。
# 配置示例：TCODE_SHARED_TRACKER_DB_PATH=/abs/path/to/shared_tracker.sqlite

# 是否显示 worker 每次成功 claim-next 的 Uvicorn 访问日志。
# 默认关闭以避免空闲轮询刷屏；失败响应和其他接口日志始终保留。
TCODE_TRACKER_POLL_ACCESS_LOG=false

# 是否自动发现 workdirs/<tenant_id>/<user_id>/<workspace_id> 下的工作区跟踪器。
# 1：自动发现全部工作区；0：关闭发现，仅使用显式指定的范围。
TCODE_WORKER_DISCOVER_WORKSPACES=1

# 可选：工作节点轮询范围，多个范围使用逗号分隔。
# 完整格式为“租户:用户:工作区”；简写“用户:工作区”时使用默认租户。
# 配置示例：TCODE_WORKER_SCOPES=admin_tenant:admin:workspace-1

# 看板页面轮询间隔，允许范围为 2～300 秒；当前代码默认值为 8。
TCODE_KANBAN_POLL_INTERVAL_SECONDS=8

# 仅显式 Workflow 可在提交后短暂收集；普通聊天一律结束提交轮，由 watcher
# 收集并展示“继续”按钮，不受旧版全局内联轮询开关影响。
# 0：不在本轮等待；正数：Workflow 最多等待对应秒数；默认值为 12。
TCODE_ASYNC_POSTPROCESS_TIMEOUT_SECONDS=12

# routed MCP 后台计算默认不设总等待时限；连接、状态请求超时与手动取消保持独立。
# 每个工具可以在 mcp.json / mcp_exec_only.json 中用 tool_timeout_seconds 覆盖。
# 0 表示无固定总时限；显式正数仍表示该作业的有限等待时限。
SYMPHONY_ROUTED_MCP_TIMEOUT_SECONDS=0
# 远端 Pythia / FoldX / 同源 MCP 的共享程序执行配置（通过 mcp_host.env -> local.env 加载）。
TMCP_RESEARCH_TIMEOUT_SECONDS="${TMCP_RESEARCH_TIMEOUT_SECONDS:-0}"

# 上述 Workflow 内联等待期间的状态轮询间隔。
# 数值越小反馈越及时、请求越频繁；数值越大请求越少、反馈越慢；当前代码默认值为 1。
TCODE_ASYNC_POSTPROCESS_POLL_INTERVAL_SECONDS=10

# 是否启动异步结果后台观察器。
# 1：后台持续收集已完成任务并注入原会话；0：关闭后台观察。
TCODE_ASYNC_WATCHER_ENABLED=1

# 后台观察器的轮询间隔；当前代码默认值为 3。
TCODE_ASYNC_WATCHER_INTERVAL_SECONDS=3

# 每个会话保留最近多少个消息 revision 快照。0 表示关闭自动清理。
# 清理只删除旧快照，当前会话内容不受影响；默认 100。
TCODE_SESSION_REVISION_RETENTION=100
# 每次会话写入最多渐进清理多少个超出保留窗口的旧 revision。
# 默认 1，避免旧数据库第一次升级时集中删除大量 FTS 数据而阻塞请求。
TCODE_SESSION_REVISION_PRUNE_BATCH=1

# 智能体工作结果被审查为 REVISE 后的最大自动返工次数。
# 0：只审查、不返工；正整数：最多返工对应次数；当前代码默认值为 1。
TCODE_REVIEW_MAX_RETRIES=1

# Worker 执行完成后，Critic / Verifier 复核阶段的最长等待时间。
# 作用：避免文献已经入库或工具结果已经生成后，复核模型卡住导致前端一直 pending。
# 当前代码默认值为 180，允许范围为 10～1800。
TCODE_WORKER_REVIEW_TIMEOUT_SECONDS=180

# 复核阶段超时或模型鉴权失败时是否放行已经完成的 Worker 结果。
# true：返回已完成结果并在结果中标记 review_failed_open，避免重复执行已完成的工具链。
# false：把复核失败视为需要返工，适合严格质量门但更容易因模型问题卡住。
TCODE_WORKER_REVIEW_FAIL_OPEN=true

# paper 文献入库后是否把证据脑同步放到后台执行。
# true：先把 doc_id / record_path 返回给前端，后台再补 evidence records，避免大 evidence store 阻塞前端。
# false：关闭后台补证据；已入库记录仍可读取，但 View source 证据可能需要后续手动同步。
TCODE_PAPER_LIBRARY_BACKGROUND_EVIDENCE_SYNC=true

# paper 后台证据同步的单次最长执行时间。
# 作用：避免 Evidence SQLite 批量同步无限占用任务资源；当前代码默认值为 180。
TCODE_PAPER_LIBRARY_EVIDENCE_SYNC_TIMEOUT_SECONDS=180

# 整条任务链路的累计返工上限，包括同一工作节点返工和失败后改派。
# 设为 0 表示首轮失败后不再返工；设为负数或留空表示不限制。
TCODE_TOTAL_REWORK_MAX_RETRIES=1

# 执行阶段遇到超时、连接中断、限流或 502/503/504 等瞬时错误时的最大重试次数。
# 0：不重试；1～3：最多重试对应次数；当前代码默认值为 1。
TCODE_EXECUTION_MAX_RETRIES=1

# 单轮对话最多允许发起的工具调用次数；达到上限后停止并向用户报告。
TCODE_MAX_TOOL_CALLS_PER_TURN=50

# 同一 task 失败或其他工具连续失败达到该次数后停止本轮，避免无效试错。
TCODE_MAX_CONSECUTIVE_TOOL_FAILURES=5

# 运行时重试的基础退避时间；实际等待时间会随重试次数递增；当前代码默认值为 1.5。
TCODE_RUNTIME_RETRY_BACKOFF_SECONDS=1.5

# 工作流阶段遇到瞬时错误时最多额外重试的次数。
# 0：不额外重试；正整数：首轮失败后最多再试对应次数；当前代码默认值为 3。
TCODE_WORKFLOW_STAGE_MAX_RETRIES=3

# 工作流阶段重试的基础退避时间，第 N 次重试等待 N × 此值；当前代码默认值为 2。
TCODE_WORKFLOW_STAGE_RETRY_BACKOFF_SECONDS=2

# 工作节点最终失败后是否自动改派。
# true：改派给其他合适节点；false：保留失败结果并停止改派。
TCODE_AUTO_REASSIGN_ON_FAILURE=false

# 自动改派允许的最大跳数。
# 0：禁止改派；正整数：最多改派对应次数；当前代码默认值为 1。
TCODE_AUTO_REASSIGN_MAX_HOPS=1

# 上传目录清理策略。设为 false 可保留异步队列任务仍需使用的上传文件。
# true：WebSocket 断开时删除会话上传目录；false：保留上传文件供异步任务继续使用。
TCODE_CLEANUP_UPLOAD_ON_DISCONNECT=false

# WebSocket 单次发送给前端的最长等待时间。
# 作用：避免工具进度、心跳、子 Agent 事件并发发送时，其中一次发送卡住拖死整条前端连接。
# 当前代码默认值为 30，允许范围为 1～300。
TCODE_WS_SEND_TIMEOUT_SECONDS=30

# ── 最终回答门控 ────────────────────────────────────────────────

# 是否在智能体准备结束时执行轻量校验，不会增加额外模型调用。
# true：启用全部门控；false：关闭全部门控；当前代码默认值为 true。
TCODE_FINAL_ANSWER_GUARD=true

# 不计入“实质性工作”的辅助工具标签，多个标签使用逗号分隔。
# planning：规划；interaction：用户交互；memory：记忆；history：历史记录。
TCODE_EVIDENCE_GATE_SUPPORT_TAGS=planning,interaction,memory,history

# 幻觉检测所检查的最短工具名长度，允许范围为 2～20。
# 数值越小检查越严格，但短词误匹配概率越高；当前代码默认值为 4。
TCODE_HALLUCINATION_MIN_TOOL_NAME_LEN=4

# ── 研究过程记录与 ResearchPack ─────────────────────────────────

# 研究体系总开关。
# true：允许按下方子开关启用研究能力；false：完全跳过研究数据库写入和派生任务。
# 当前启用 Journal、Attribution Shadow、Candidate 和 Research State Preview；仍不改变提示词和 Agent 回答。
TCODE_RESEARCH_ENABLED=true

# 是否记录 Session、Turn、消息、Tool、MCP、Artifact、File 和子 Agent 的追加式研究事件。
# 关闭后不会创建 .tcode/research/research.sqlite3。
TCODE_RESEARCH_JOURNAL_ENABLED=true

# 研究事件是否保存经过脱敏的有限正文预览。
# true：保存有限预览，便于后续归属；false：只保存来源、哈希和结构化元数据。
TCODE_RESEARCH_STORE_CONTENT_PREVIEW=true

# 每个正文、参数或工具结果预览最多保留的字符数；Secret 字段始终会被清理。
TCODE_RESEARCH_CONTENT_PREVIEW_CHARS=500

# 单个研究事件 Payload 的最大字节数，超过后只保存脱敏后的截断摘要。
TCODE_RESEARCH_MAX_PAYLOAD_BYTES=65536

# 可选：研究数据库目录。留空时使用当前 Workspace 的 .tcode/research。
# 相对路径按当前 Workspace 解析；生产环境可填写独立持久卷的绝对路径。
TCODE_RESEARCH_STORE_ROOT=

# SQLite 等待其他写事务释放锁的最长时间，单位为毫秒。
# 研究记录采用 Fail Open，锁冲突超过 1 秒就放弃本次同步写入并进入 Dead Letter，避免拖死聊天和前端请求。
TCODE_RESEARCH_DB_BUSY_TIMEOUT_MS=1000

# 研究记录失败时是否继续原有聊天和工具执行。
# true：写入失败进入 Dead Letter，但不影响用户当前操作；建议始终保持开启。
TCODE_RESEARCH_WRITE_FAIL_OPEN=true

# 是否启用研究归属引擎。
# 当前仅允许与下方 Shadow Mode 同时开启；归属结果不直接进入 Prompt，但可作为 Candidate/Episode 的受控输入。
TCODE_RESEARCH_ATTRIBUTION_ENABLED=true

# 归属 Shadow Mode：只在后台计算，不把判断写入 Agent 上下文，也不改变回答。
TCODE_RESEARCH_ATTRIBUTION_SHADOW_MODE=true

# Journal 新事件写入后，是否投递到有界后台队列进行 Shadow 归属。
# true：异步处理，不等待归属结果即继续用户对话；false：只允许手动 API 批处理。
TCODE_RESEARCH_ATTRIBUTION_AUTO_DISPATCH=true

# Shadow 每批最多处理的事件数，允许范围 1～1000。
TCODE_RESEARCH_ATTRIBUTION_BATCH_SIZE=100

# Shadow 后台队列最多暂存的新事件数。
# 队列已满时 Journal 仍然成功，未投递事件由后续对账或手动重算补齐。
TCODE_RESEARCH_ATTRIBUTION_QUEUE_SIZE=4096

# 收到首条研究事件后等待同一波事件合并的时间，单位为毫秒。
# 论文工具通常会连续产生 Tool、File、Artifact 等多条事件；合并后只执行一次课题和活动派生，避免重算风暴。
TCODE_RESEARCH_ATTRIBUTION_DEBOUNCE_MS=1000

# 非用户新消息可以继承同 Session 最近研究上下文的时间窗口，单位为分钟。
# 用户的新消息永远不因此规则自动继承，用于防止中途闲聊被带入研究。
TCODE_RESEARCH_ATTRIBUTION_SESSION_CONTEXT_MINUTES=20

# 是否允许 Attribution 调用模型。当前阶段必须为 false，只运行确定性规则与谱系继承，额外模型 Token 为 0。
TCODE_RESEARCH_ATTRIBUTION_MODEL_ENABLED=false

# Web 服务启动后是否在后台对近期 Session 执行一次轻量幂等对账。
# 对账会补 ResearchEvent、Shadow 归属、Candidate 和已确认 Project 的派生状态，但不会修改原 Session 或 Prompt。
TCODE_RESEARCH_AUTO_RECONCILE_ON_STARTUP=true

# 启动对账最多回看最近多少天的 Session；避免一次回填全部历史污染 Shadow 评测。
TCODE_RESEARCH_RECONCILE_RECENT_DAYS=30

# 无法归属的 Pending 事件允许继续自动分析的天数；到期后转为 Frozen。
TCODE_RESEARCH_PENDING_TTL_DAYS=30

# 自然语言研究操作（如确认正式课题、生成 ResearchPack）的待确认票据有效期，单位为分钟。
# 超时后用户回复“确认”不会再执行旧操作，必须让 Agent 重新生成预览；默认 30，允许 5–1440。
TCODE_RESEARCH_ACTION_TTL_MINUTES=30

# 自动纳入课题的最低置信度，范围 0～1；低于阈值时保持 Pending 或等待用户纠正。
TCODE_RESEARCH_AUTO_INCLUDE_THRESHOLD=0.90

# 是否开启 Topic Candidate Preview。
# true：把满足最低信号门槛的研究事件形成可见候选；候选仍不会注入 Agent Prompt。
TCODE_RESEARCH_TOPICS_ENABLED=true

# Attribution 完成后是否自动执行确定性 Candidate 聚合；不调用模型，额外模型 Token 为 0。
TCODE_RESEARCH_TOPIC_AUTO_DISCOVERY=true

# 同一主题至少需要多少个有意义事件，且必须包含 Tool、论文或 Artifact，才允许自动建候选。
TCODE_RESEARCH_TOPIC_MINIMUM_MEANINGFUL_EVENTS=3

# 同一主题至少跨多少个 Session 时可以突破单 Session 事件门槛。
TCODE_RESEARCH_TOPIC_CROSS_SESSION_SIGNAL=2

# 两组关键词的 Jaccard 重叠度达到此值时才允许聚合，范围 0～1。
TCODE_RESEARCH_TOPIC_KEYWORD_OVERLAP_THRESHOLD=0.34

# Candidate 稳定度达到此值后从 emerging 进入 stable；确认 Project 仍需要用户操作。
TCODE_RESEARCH_TOPIC_STABLE_SCORE_THRESHOLD=0.65

# 每个 Workspace 同时最多保留多少个未确认候选；超过上限的新主题继续留在待整理区。
# 当前产品约束为 3，避免候选列表不断膨胀并让课题边界失去可解释性。
TCODE_RESEARCH_TOPIC_MAX_CANDIDATES=3

# 研究活动聚合：保留原始 Event，但待整理只展示聚合后的可读研究活动。
TCODE_RESEARCH_ACTIVITIES_ENABLED=true

# 工具已经开始却没有完成事件时，超过该分钟数标记为“执行记录不完整”。
TCODE_RESEARCH_ACTIVITY_INCOMPLETE_MINUTES=30

# 在线 Activity 只读取与本批 Event 的 Turn、Trace、父链和稳定调用链相连的事件。
# 达到上限后停止扩张，完整修复仍由维护型 rebuild_owner 执行。
TCODE_RESEARCH_ACTIVITY_INCREMENTAL_MAX_EVENTS=1000

# 将 durable/supporting Activity、Episode 决策和失败确定性投影为持久 Experience。
# 该过程不调用模型；关闭后不影响 Journal、Route、Activity 或 Episode。
TCODE_RESEARCH_EXPERIENCE_PROJECTION_ENABLED=true

# 每个 Workspace 最多允许创建多少个未归档的本地正式 Research Project。
# 导入 ResearchPack 内部的来源项目视图不占用这三个名额。
TCODE_RESEARCH_MAX_PROJECTS_PER_WORKSPACE=3

# 顶层 Turn 研究路由：优先复用主 Agent 同轮隐藏元数据；只有模糊归属时最多补判一次。
TCODE_RESEARCH_ROUTING_ENABLED=true
TCODE_RESEARCH_ROUTING_MODEL_FALLBACK_ENABLED=true
TCODE_RESEARCH_ROUTING_CONFIDENCE_THRESHOLD=0.72
TCODE_RESEARCH_ROUTING_CONTEXT_TOKEN_BUDGET=400
# 导入 ResearchPack Scope 只注入元数据索引，并使用独立硬预算。
TCODE_RESEARCH_ROUTING_IMPORTED_CONTEXT_TOKEN_BUDGET=320
# 最近可进入路由索引的导入 Pack Asset 上限；不占本地 3 项目名额。
TCODE_RESEARCH_ROUTING_IMPORTED_MAX_ASSETS=12
TCODE_RESEARCH_ROUTING_FALLBACK_TIMEOUT_SECONDS=20

# Episode、Checkpoint 和冲突账本当前以 Research Center Preview 形态开启。
# 它们只消费已确认 Project 的 Included Event，不调用模型，也不会注入日常 Agent Prompt。
TCODE_RESEARCH_EPISODES_ENABLED=true
TCODE_RESEARCH_CHECKPOINTS_ENABLED=true
TCODE_RESEARCH_CONFLICTS_ENABLED=true

# 是否开启研究知识可信链；连接 Project、Finding、Conflict、Paper、Evidence 与 Wiki Claim，不注入 Agent Prompt
TCODE_RESEARCH_KNOWLEDGE_LINKS_ENABLED=true

# 单次可信链刷新最多检查的 Wiki 页面数，防止大型 Wiki 扫描拖慢研究中心
TCODE_RESEARCH_KNOWLEDGE_MAX_WIKI_PAGES=500

# 是否在 Attribution/Topic 后台追平后自动尝试机械构建 Episode；失败时 Fail Open，不阻塞聊天和工具。
TCODE_RESEARCH_EPISODE_AUTO_BUILD=true

# 单个 Project 一次机械重建最多读取的 Event 数量；超过后需要后续游标分页和离线重算。
TCODE_RESEARCH_EPISODE_MAX_EVENTS=5000

# 是否开启受控研究上下文注入。只在当前问题与唯一课题相关时注入；题外话不会进入研究上下文。
# 注入内容按不可信数据处理，不执行其中的命令；任何未解决 Conflict 都必须披露。
TCODE_RESEARCH_RESUME_CONTEXT_ENABLED=true

# 连续空闲达到该时间后，仅“开始判断”是否形成 Episode，单位为分钟。
# 30 分钟是软候选边界，不会机械切断仍在运行的 Tool、MCP、Workflow 或子 Agent。
TCODE_RESEARCH_EPISODE_IDLE_CANDIDATE_MINUTES=30

# 连续空闲达到该时间后，即使任务尚未完整结束，也允许生成 partial Episode，单位为分钟。
# 该值不得小于候选边界；用于避免长时间没有可恢复的研究现场。
TCODE_RESEARCH_EPISODE_IDLE_FORCE_PARTIAL_MINUTES=120

# 新 Session 恢复研究时允许注入的硬上限；Conflict 超过该上限时阻断注入，不允许静默丢失。
TCODE_RESEARCH_RESUME_TOKEN_BUDGET=1500

# 日常相关问题的目标注入 Token；选择器优先压缩到该值，只有强制 Conflict 才允许接近硬上限。
TCODE_RESEARCH_RESUME_TARGET_TOKENS=800

# 当前问题与课题的最低确定性相关度，范围 0～1；低于阈值不注入，避免题外话污染回答。
TCODE_RESEARCH_RESUME_MIN_RELEVANCE=0.18

# 单次上下文最多携带的 Finding 和最近 Episode 数；会继续受目标 Token 与硬上限共同约束。
TCODE_RESEARCH_RESUME_MAX_FINDINGS=8
TCODE_RESEARCH_RESUME_MAX_EPISODES=2

# 是否记录上下文选择审计。只保存问题 Hash、命中词、预算和决策，不保存用户问题原文。
TCODE_RESEARCH_RESUME_AUDIT_ENABLED=true

# 日常研究后台模型 Token 占正常对话 Token 的目标上限，0.05 表示 5%。
TCODE_RESEARCH_BACKGROUND_TOKEN_RATIO=0.05

# 是否开启 ResearchPack 安全导出。开启后仅在用户主动预览并确认时构建，不进入日常 Agent Prompt。
TCODE_RESEARCH_PACK_ENABLED=true

# 单个 ResearchPack 最多收集多少条已归属当前课题的 ResearchEvent。
# 只读取研究事件账本，不读取完整私人 Session；strict 模式不会导出 Event Payload。
TCODE_RESEARCH_PACK_MAX_EVENTS=5000

# 单个 ResearchPack 文件夹和 ZIP 的最大字节数，默认 256 MiB；超出时硬阻断导出。
TCODE_RESEARCH_PACK_MAX_BYTES=268435456

# 单篇文献全部派生层、以及单个派生层的硬上限。不会截断；超过任一上限会在预览中阻断导出。
# 文献包只携带 JSON/JSONL 派生知识，不携带 PDF、页面图片、附件或向量索引。
TCODE_RESEARCH_PACK_MAX_PAPER_BYTES=134217728
TCODE_RESEARCH_PACK_MAX_PAPER_LAYER_BYTES=67108864

# 单个子 Agent 文本产物写入研究包的最大字节数，默认 2 MiB。
# standard 导出只携带脱敏后的 contract、summary、result、tool_trace；full-research 还可携带 full_result。
TCODE_RESEARCH_PACK_MAX_TEXT_ARTIFACT_BYTES=2097152

# ResearchPack 服务端私有存放目录。留空时使用 Workspace 下的 .tcode/research/packs。
# 接口只通过 pack_id 下载，绝不会把这个本地路径返回给浏览器。
TCODE_RESEARCH_PACK_EXPORT_ROOT=

# 是否开启 ResearchPack 两步式安全导入。必须先上传检查，再由用户确认创建独立副本。
# 导入不会执行包内 SKILL、脚本、依赖或 MCP 配置，也不会自动注入 Agent Prompt。
TCODE_RESEARCH_PACK_IMPORT_ENABLED=true

# 是否在服务启动时恢复被进程异常中断的导入，并清理过期暂存包及可识别的孤立对象。
TCODE_RESEARCH_PACK_IMPORT_RECOVERY_ENABLED=true

# 上传压缩包本身的最大字节数，默认 256 MiB；读取过程中超过上限会立即停止。
TCODE_RESEARCH_PACK_IMPORT_MAX_ARCHIVE_BYTES=268435456

# ZIP 解压后所有文件的最大总字节数，默认 256 MiB，用于阻断 Zip Bomb。
TCODE_RESEARCH_PACK_IMPORT_MAX_UNCOMPRESSED_BYTES=268435456

# 单个 ResearchPack ZIP 允许包含的最大文件数量。
TCODE_RESEARCH_PACK_IMPORT_MAX_FILES=5000

# 允许的最大压缩比；单文件或整个 ZIP 超过该比例都会被拒绝。
TCODE_RESEARCH_PACK_IMPORT_MAX_COMPRESSION_RATIO=100

# 安全检查通过后等待用户确认的有效时间，单位为分钟；过期必须重新上传检查。
TCODE_RESEARCH_PACK_IMPORT_INSPECTION_TTL_MINUTES=60

# ResearchPack 导入暂存目录。留空时使用 Workspace 下的 .tcode/research/pack-imports。
# 暂存文件为 Owner 私有，完成、取消或过期后会清理，不允许前端提交任意服务端路径。
TCODE_RESEARCH_PACK_IMPORT_ROOT=

# ── 长期记忆 ────────────────────────────────────────────────────

# 全局长期记忆写入策略：
# - primary-only：仅主智能体和额外放行的智能体可以写入。
# - all：所有智能体都可以写入。
# - none：禁止所有智能体写入。
TCODE_GLOBAL_MEMORY_WRITE_MODE=primary-only

# 可选：在 primary-only 模式下额外允许写入的智能体名称，多个名称使用逗号分隔。
# 留空：不额外放行；填写名称：对应智能体获得写权限，名称不区分大小写。
# 配置示例：TCODE_GLOBAL_MEMORY_WRITE_ALLOW_AGENTS=

# 全局长期记忆文件允许保存的最大条目数；当前代码默认值为 1000。
TCODE_MEMORY_MAX_ENTRIES=1000

# 达到条目上限后是否自动合并最相似的记忆。
# 1：自动合并后继续写入；0：保留全部条目；当前代码默认值为 1。
TCODE_MEMORY_AUTO_COMPACT=1

# Team / Worker / Session 记忆的独立条数上限。超限时优先合并最旧且语义最相近的记录，
# 不直接丢弃正文；默认分别为 500 / 1000 / 200。
TCODE_TEAM_MEMORY_MAX_ENTRIES=500
TCODE_WORKER_MEMORY_MAX_ENTRIES=1000
TCODE_SESSION_MEMORY_MAX_ENTRIES=200

# 作用域记忆自动压缩总开关，也可用 TCODE_{TEAM|WORKER|SESSION}_MEMORY_AUTO_COMPACT
# 对单一层级覆盖。1：自动合并；0：保留全部条目。
TCODE_SCOPED_MEMORY_AUTO_COMPACT=1

# 是否把 bash、MCP 和子智能体任务的结构化结果自动写入全局长期记忆。
# 1：自动写入；0：关闭自动写入；当前代码默认值为 1。
TCODE_AUTO_MEMORY_ENABLED=1

# 自动写入长期记忆所需的最低置信度，允许范围为 0～1。
# 0：接受所有结果；1：仅接受最高置信度结果；当前代码默认值为 0.5。
TCODE_AUTO_MEMORY_MIN_CONFIDENCE=0.5

# ── Skill 路由与自动加载 ────────────────────────────────────────

# 是否允许自动预加载 Skill。
# 1：达到阈值后自动加载；0：只能通过 skill 工具手动加载；当前代码默认值为 1。
TCODE_SKILL_AUTO_LOAD_ENABLED=1

# 是否真正预加载混合路由器选中的唯一主 Skill。
# 1：例如“分子对接”稳定命中 gnina-runner 时，在模型执行前完成加载。
TCODE_AUTO_PRELOAD_RECOMMENDED_SKILLS=1

# 旧版路由器的自动加载最低分，仅在回退到旧版逻辑时生效；当前代码默认值为 5.0。
# 混合路由器的阈值在 TCODE_CONFIG_ROOT/skill_routing.yaml 中配置。
TCODE_SKILL_AUTO_LOAD_MIN_SCORE=5.0

# 混合 Skill 路由总开关。
# 1：使用混合路由；0：回退到旧版推荐逻辑；当前配置文件默认值为 1。
TCODE_SKILL_ROUTING_ENABLED=1

# 是否记录 Skill 路由跟踪信息。
# 1：写入路由跟踪；0：不写入；当前配置文件默认值为 1。
TCODE_SKILL_ROUTING_TRACE_ENABLED=1

# ── 人工审查 ────────────────────────────────────────────────────

# 是否启用人工审查。
# true：按规则拦截并请求审查；false：所有工具跳过人工审查；当前代码默认值为 true。
HUMAN_REVIEW_ENABLED=true

# 人工审查规则文件。本机初始化后位于 TCODE_CONFIG_ROOT/human_review.json。
HUMAN_REVIEW_CONFIG_PATH="${HUMAN_REVIEW_CONFIG_PATH:-${TCODE_CONFIG_ROOT:-config}/human_review.json}"

# 人工审查接口地址。
TCODE_HUMAN_REVIEW_API_BASE=http://127.0.0.1:5554

# ── 沙箱总开关与运行方式 ────────────────────────────────────────

# 是否启用 Docker + gVisor 强沙箱。
# 该设置主要作用于命令型工具链和高风险 MCP 边界；
# job_protocol_mcp.py 仅负责任务代理，不读取沙箱配置，也不会被放入容器。
# 本地 macOS 没有 runsc 时建议关闭；Linux 生产环境建议开启。
TCODE_SANDBOX_ENABLED=true
# TCODE_SANDBOX_ENABLED=false
# 沙箱模式：
# - off：完全关闭沙箱。
# - runtime：仅将 bash、exec、process 和插件运行时等执行入口放入沙箱。
# - all：为完整会话沙箱预留，当前仍以已接入的工具入口为准。
# - non-main：为“主会话运行在宿主机、子会话进入沙箱”预留。
TCODE_SANDBOX_MODE=runtime

# 当前实现的沙箱后端和 Docker 运行时名称。
# 使用前需在服务器 Docker 守护进程中注册 runsc。
# 可选值为 docker-gvisor、docker、local-docker；当前推荐 docker-gvisor。
TCODE_SANDBOX_BACKEND=docker-gvisor

# 填写 Docker 已注册的运行时名称；gVisor 通常为 runsc。
TCODE_SANDBOX_DOCKER_RUNTIME=runsc

# 可选：智能体未在 tcode.json 中声明 sandbox_profile 时使用的默认档案名称。
# 留空：使用基础沙箱配置；填写名称：使用 tcode.json 中对应的 sandbox_profiles 配置。
# 配置示例：TCODE_SANDBOX_DEFAULT_PROFILE=

# Web 进程不直接调用 Docker。生产环境应单独启动 sandbox-runner，
# 并确保 Web 系统用户不属于 docker 用户组且无法读取 Docker 套接字。
# TCODE_SANDBOX_REQUIRE_RUNNER 为 true 时，没有执行器地址会直接报错；false 时允许回退到本地 Docker。
TCODE_SANDBOX_REQUIRE_RUNNER=false

# sandbox-runner 的 HTTP 接口地址；留空时按 REQUIRE_RUNNER 决定报错或回退本地 Docker。
TCODE_SANDBOX_RUNNER_URL=http://127.0.0.1:19091

# sandbox-runner 认证令牌文件；文件内容会作为请求使用的令牌。
TCODE_SANDBOX_RUNNER_TOKEN_FILE=/etc/tcode/sandbox-runner.token

# ── 沙箱容器与执行器 ────────────────────────────────────────────

# Web 与 sandbox-runner 使用相同的固定容器用户，避免继承宿主进程身份。
# 工作区目录需通过所有者、用户组或访问控制列表允许该用户读写。
# 格式为“用户编号:用户组编号”，决定容器进程身份。
TCODE_SANDBOX_USER=1000:1000

# 容器内主目录。
TCODE_SANDBOX_HOME=/tmp/home

# true：容器根文件系统只读；false：允许写入根文件系统。
TCODE_SANDBOX_READ_ONLY=true

# 工作区快照、冲突文件和任务日志的保存策略。
# TCODE_SANDBOX_WORKSPACE_SNAPSHOTS 为 true 时启用快照，false 时不创建快照。
TCODE_SANDBOX_WORKSPACE_SNAPSHOTS=true

# 工作区快照保存目录。
TCODE_SANDBOX_SNAPSHOT_ROOT=/var/lib/tcode-sandbox-runner/snapshots

# 快照回写冲突文件保存目录。
TCODE_SANDBOX_CONFLICT_ROOT=/var/lib/tcode-sandbox-runner/conflicts

# 沙箱任务日志保存目录。
TCODE_SANDBOX_JOB_LOG_ROOT=/var/lib/tcode-sandbox-runner/logs

# 单个 Docker 任务日志达到此大小后滚动；10m 可限制高噪声命令的磁盘占用。
TCODE_SANDBOX_LOG_MAX_SIZE=10m

# 每个 Docker 任务最多保留的滚动日志文件数；当前总上限约为 20 MiB。
TCODE_SANDBOX_LOG_MAX_FILES=2

# sandbox-runner 的 /output 接口单次最多返回多少字节，避免巨量日志进入 Web 进程。
TCODE_SANDBOX_JOB_OUTPUT_RESPONSE_MAX_BYTES=524288

# Web 到 sandbox-runner 的任意 HTTP 响应硬上限；即使 Runner 配置异常也不会无界读入内存。
TCODE_SANDBOX_RUNNER_RESPONSE_MAX_BYTES=8388608

# 临时容器删除前，sandbox-runner 最多持久化多少字节的头尾日志。
TCODE_SANDBOX_PERSISTED_LOG_MAX_BYTES=2097152

# Persistent Runtime 单个任务的 output.log 最大字节数；容器内采集器会持续排空并有界保存。
TCODE_PERSISTENT_JOB_OUTPUT_MAX_BYTES=2097152

# sandbox-runner 的强制校验与任务生命周期设置。
# true：要求每个任务启用快照；false：不强制快照。
TCODE_SANDBOX_RUNNER_REQUIRE_SNAPSHOTS=true

# true：要求请求携带所有者信息；false：不校验所有者元数据。
TCODE_SANDBOX_RUNNER_REQUIRE_OWNER_METADATA=true

# 允许的“用户编号:用户组编号”列表；未列出的容器身份会被拒绝。
TCODE_SANDBOX_RUNNER_ALLOWED_USERS=1000:1000,0:0

# true：允许容器用户为 root；false：禁止容器 root。
TCODE_SANDBOX_RUNNER_ALLOW_CONTAINER_ROOT=true

# true：允许可写根文件系统；false：强制根文件系统只读。
TCODE_SANDBOX_RUNNER_ALLOW_WRITABLE_ROOT=true

# root Runtime 总开关。true：启用按认证 user_id 路由；false：所有用户均使用普通非 root Runtime。
TCODE_SANDBOX_ROOT_RUNTIME_ENABLED=true

# 容器 root 白名单，填写 /api/auth/me 返回的 user.user_id，多个 ID 使用英文逗号分隔。
# 当前只授权 bootstrap 管理员 admin。增加用户示例：admin,user-001,user-002
# 该白名单只控制容器 root 权限，不会授予后台 admin/owner 角色；Agent 请求参数也不能修改它。
TCODE_SANDBOX_ROOT_RUNTIME_USER_IDS=admin

# 白名单用户最终使用的 sandbox profile；必须对应 tcode.json 中 persistent + 0:0 + read_only=false 的 profile。
TCODE_SANDBOX_ROOT_RUNTIME_PROFILE=workspace_root_runtime

# 可自动升级的普通 profile 名称列表，英文逗号分隔；名称必须存在于 tcode.json。
# 当前建议值：workspace_runtime、executor、networked、default。不要加入 browser、blast_tools 或 MCP 专用 profile。
TCODE_SANDBOX_ROOT_RUNTIME_BASE_PROFILES=workspace_runtime,executor,networked,default

# 单个任务允许声明的最大超时时间；当前值 2592000 等于 30 天。
TCODE_SANDBOX_RUNNER_MAX_TIMEOUT_SECONDS=2592000

# Workspace 删除状态数据库，用于记录 active、deleting、deleted、purging、purge_failed、purged
# 状态和最近一次清理错误；永久删除后保留 purged 最小审计记录。
# 相对路径会由后端基于 TCODE_WORKDIR（即 TCode 服务工作目录）解析，不受启动命令当前目录影响。
# 当前值最终对应 <TCODE_WORKDIR>/.tcode/workspaces.sqlite3；后端会自动创建父目录和数据库表。
# 本数据库只保存 Workspace 状态，不保存项目文件、会话正文或 Docker 容器内容。
# 生产环境可以在 config/examples/sandbox_production.env.example 中覆盖为持久绝对路径，例如 /var/lib/tcode/workspaces.sqlite3。
TCODE_WORKSPACE_STATE_DB=.tcode/workspaces.sqlite3

# 执行器任务状态文件。
TCODE_SANDBOX_RUNNER_STATE_FILE=/var/lib/tcode-sandbox-runner/jobs.json
# 常驻 Runtime 的 SQLite Registry；必须位于持久化目录，代码会将数据库权限收紧为 0600。
TCODE_SANDBOX_RUNTIME_STATE_FILE=/var/lib/tcode-sandbox-runner/runtimes.sqlite
# 大于 0：空闲达到该秒数后 stop；0：不因空闲自动 stop。
TCODE_SANDBOX_RUNTIME_IDLE_STOP_SECONDS=3600
# 大于 0：stop 达到该秒数后删除容器但保留 Runtime HOME；604800 等于 7 天；0 表示永不自动删除。
TCODE_SANDBOX_RUNTIME_RETENTION_SECONDS=604800

# 执行器清理已结束任务的检查间隔；当前代码默认值为 2。
TCODE_SANDBOX_RUNNER_REAPER_INTERVAL_SECONDS=2

# sandbox-runner 允许使用的镜像、工具、网络模式和只读挂载根目录。
# skill_run 会把 Skill 目录以只读方式挂载进沙箱。
# 列表中未声明的镜像、工具、网络或挂载根目录会被执行器拒绝。
# 默认执行镜像。
TCODE_SANDBOX_IMAGE=tcode-executor:py312

# 执行器允许使用的镜像列表。
TCODE_SANDBOX_RUNNER_ALLOWED_IMAGES=tcode-executor:py312,tcode-browser:playwright,tcode-tools-blast:latest

# 执行器允许接收的工具列表，支持 plugin:* 等通配模式。
TCODE_SANDBOX_RUNNER_ALLOWED_TOOLS=bash,exec,browser,skill_run,plugin_runtime,plugin_network,plugin:*

# 执行器允许的网络模式列表；可选 none、internal、egress。
TCODE_SANDBOX_RUNNER_ALLOWED_NETWORKS=none,internal,egress

# 执行器允许挂载的宿主机目录根列表，挂载目标必须位于这些目录内。
TCODE_SANDBOX_RUNNER_ALLOWED_MOUNT_ROOTS=.claude/skills,plugins

# 按“工具 + 能力”限制镜像与网络，作为执行器侧的第二层校验。
TCODE_SANDBOX_RUNNER_TOOL_POLICY_FILE="${TCODE_SANDBOX_RUNNER_TOOL_POLICY_FILE:-${TCODE_CONFIG_ROOT:-config}/sandbox_runner_tool_policy.json}"

# 可选：服务器只读软件环境和大型数据库的统一挂载配置文件。
# 留空：不加载额外静态资源；填写路径：加载该文件中声明的只读挂载和环境变量。
# 配置示例：TCODE_SANDBOX_STATIC_RESOURCES_FILE=/etc/tcode/sandbox-static-resources.json

# 可选：工作区私有数据库和服务映射策略文件。
# 留空：不注入私有服务；填写路径：由执行器按策略管理服务映射。
# 配置示例：TCODE_SANDBOX_WORKSPACE_SERVICE_POLICY_FILE=/etc/tcode/sandbox-workspace-services.json

# ── 沙箱工作区与外部资源 ────────────────────────────────────────

# 宿主机允许作为沙箱工作区的父目录，以及容器内工作目录。
# 实际挂载的仍是当前会话工作区，不会把仓库根目录整体挂入容器。
TCODE_SANDBOX_WORKSPACE_ROOT=workdirs

# 工作区在容器内映射到的路径。
TCODE_SANDBOX_CONTAINER_WORKDIR=/workspace

# 是否将文件工具限制在当前工作区和已导入的只读外部资源中。
TCODE_WORKSPACE_IO_GUARD=1

# 是否允许文件工具绕过工作区保护，直接读写宿主机外部路径。
# 生产环境建议关闭；需要外部资源时应先调用 import_resource。
# true：允许直接读取；false：读取前必须先导入资源。
TCODE_WORKSPACE_IO_ALLOW_EXTERNAL_READ=true

# true：允许直接写入；false：禁止写入工作区外路径。
TCODE_WORKSPACE_IO_ALLOW_EXTERNAL_WRITE=false

# 导入或挂载工作区外路径前是否必须向用户请求权限。
TCODE_IMPORT_RESOURCE_REQUIRE_PERMISSION=true

# 自动导入模式下，小文件复制到工作区，大文件或目录只读挂载。
# 挂载阈值单位为字节，67108864 等于 64 MiB。
TCODE_IMPORT_RESOURCE_AUTO_MOUNT_BYTES=67108864

# 自动导入模式下是否仍强制复制目录。
TCODE_IMPORT_RESOURCE_AUTO_COPY_DIRS=false

# 复制外部资源时允许的最大总字节数和最大文件数。
# 只读挂载不受这两个阈值限制。
# 最大复制体积；当前值 524288000 等于 500 MiB。
TCODE_EXTERNAL_INPUT_IMPORT_MAX_BYTES=524288000

# 最大复制文件数；当前代码默认值为 2048。
TCODE_EXTERNAL_INPUT_IMPORT_MAX_FILES=2048

# ── 沙箱资源与网络 ──────────────────────────────────────────────

# 默认网络模式：none 表示无网络；internal 表示仅内部网络；egress 表示通过受控出口联网。
TCODE_SANDBOX_DEFAULT_NETWORK=none

# 默认内存上限，支持 k、m、g 等单位；当前代码默认值为 2g。
TCODE_SANDBOX_DEFAULT_MEMORY=2g

# 默认 CPU 核数上限；当前代码默认值为 2。
TCODE_SANDBOX_DEFAULT_CPUS=2

# 默认最大进程数；当前代码默认值为 256。
TCODE_SANDBOX_DEFAULT_PIDS_LIMIT=256

# 默认任务超时时间；当前代码默认值为 120。
TCODE_SANDBOX_DEFAULT_TIMEOUT_SECONDS=120

# Chromium 和 Playwright 通常需要较大的 /dev/shm。
TCODE_SANDBOX_SHM_SIZE=1g

# 允许联网的工具名称列表。
# 留空：没有通用工具获得联网权限；填写工具名：命中工具使用 TCODE_SANDBOX_ALLOWED_NETWORK。
TCODE_SANDBOX_NETWORK_ALLOWED_TOOLS=

# 联网工具使用的网络模式，可选 none、internal、egress；当前代码默认值为 egress。
TCODE_SANDBOX_ALLOWED_NETWORK=egress

# 受控出口代理地址及其容器名称。
TCODE_SANDBOX_EGRESS_PROXY=http://egress-proxy:3128

# 受控出口代理所在的容器名称，用于建立沙箱网络连接。
TCODE_SANDBOX_EGRESS_PROXY_CONTAINER=tcode-egress-proxy

# ── 沙箱工具策略 ────────────────────────────────────────────────

# 真正进入 Docker/gVisor 执行的工具组：
# - group:all：全部工具，等价于 *。
# - group:runtime：bash、exec、process 和 process_runtime。
# - group:fs：read、write、edit、glob、grep 和 import_resource。
# - group:web：webfetch 和 websearch。
# - group:ui：浏览器及界面自动化工具。
# - group:mcp：所有 MCP 工具。
# - group:plugins：插件运行时命令和插件工具。
# - group:orchestration：多智能体和协作编排工具。
TCODE_SANDBOX_TOOL_RUN_GROUPS=group:runtime,group:plugins

# 沙箱模式下的工具可见性策略，值为工具名或 group:*，多个值使用逗号分隔。
# 允许列表留空：不额外限制；非空：只允许命中项。
# 拒绝列表留空：不额外拒绝；非空：命中项始终隐藏并禁止调用。
TCODE_SANDBOX_TOOL_ALLOW=

# 拒绝列表优先级高于允许列表。
TCODE_SANDBOX_TOOL_DENY=

# ── 浏览器沙箱 ──────────────────────────────────────────────────

# 原生浏览器工具使用的 Playwright/Chromium 镜像。
# agent-browser 会优先调用原生浏览器工具，不通过 Bash 或浏览器 MCP 操作。
TCODE_BROWSER_SANDBOX_IMAGE=tcode-browser:playwright

# true：原生 browser 工具必须通过独立 sandbox-runner，禁止回退为 Web 进程直调 Docker。
TCODE_BROWSER_REQUIRE_RUNNER=true

# 原生 browser 工具只接受专用 Browser Agent，其他 Agent 必须通过 task 委派。
TCODE_BROWSER_ALLOWED_AGENTS=browser

# 高风险 Skill 必须由专用 Agent 加载，其动作继续使用对应的固定 sandbox profile。
TCODE_SKILL_AGENT_BINDINGS=agent-browser:browser
TCODE_SKILL_SANDBOX_PROFILE_BINDINGS=agent-browser:browser

# 可选：浏览器优先使用的沙箱档案名称。
# 留空时使用 browser；档案不存在时回退到 TCODE_BROWSER_SANDBOX_IMAGE。
# 配置示例：TCODE_BROWSER_SANDBOX_PROFILE=browser

# 浏览器镜像中的 Node 模块和 Playwright 浏览器二进制路径。
TCODE_BROWSER_NODE_PATH=/opt/tall/browser/node_modules

# Playwright 浏览器二进制目录。
TCODE_BROWSER_PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# 浏览器 MCP 的目标位置：
# - sandbox：要求对应 MCP 已容器化并在沙箱服务列表中声明。
# - host：仅适合可信的单用户环境，并需允许控制宿主机浏览器。
# - node：用于远程浏览器代理，并需单独允许远程节点。
TCODE_BROWSER_MCP_TARGET=sandbox
# false：禁止控制宿主机浏览器；true：仅在可信单用户环境允许 host 目标。
TCODE_BROWSER_ALLOW_HOST_CONTROL=false
# false：禁止远程浏览器节点；true：允许 node 目标。
TCODE_BROWSER_NODE_ALLOWED=false
# 用于识别浏览器类 MCP 的服务名或“服务名.工具名”通配模式。
TCODE_BROWSER_MCP_SERVER_PATTERNS=*browser*,*playwright*,*chrome*,*cdp*

# 原生浏览器工具仅通过受控出口代理联网。
TCODE_BROWSER_SANDBOX_NETWORK=egress

# 同一 browser session 保持 Chromium 常驻的空闲时长（秒）。
# 在此期间连续的 click/fill/snapshot 等动作复用同一页面和登录状态。
TCODE_BROWSER_SESSION_IDLE_SECONDS=1800

# 浏览器实时观察画面的目标帧率。允许 1～12；默认 5 可兼顾交互连续性和带宽。
TCODE_BROWSER_LIVE_FPS=5

# CDP 截屏流的 JPEG 质量。允许 25～85；值越高画面越清晰、传输量越大。
TCODE_BROWSER_LIVE_JPEG_QUALITY=60

# 首次启动 Chromium 并产出 ready 状态的最长等待时间（秒），允许 5～120。
TCODE_BROWSER_LIVE_STARTUP_TIMEOUT_SECONDS=45

# WebSocket 接受的单帧最大字节数；超限帧会被丢弃，避免异常画面占用连接内存。
TCODE_BROWSER_LIVE_MAX_FRAME_BYTES=4194304

# ── MCP 沙箱边界与路径保护 ──────────────────────────────────────

# 异步 Protein Run 对普通稳定输入采用“较小文件复制、较大文件只读挂载”。
TCODE_PROTEIN_RUN_INPUT_COPY_MAX_BYTES="${TCODE_PROTEIN_RUN_INPUT_COPY_MAX_BYTES:-67108864}"
TCODE_PROTEIN_RUN_INPUT_COPY_MAX_FILES="${TCODE_PROTEIN_RUN_INPUT_COPY_MAX_FILES:-256}"

# 来自 task-subagent/worktree/外部临时目录的异步输入不能只读挂载，因为提交者
# 可能在目标 MCP 启动前被清理。此类输入必须复制到 async-mcp Protein Run；
# 超过以下硬上限时在入队阶段明确失败，避免留下必然失效的源路径。
TCODE_PROTEIN_RUN_DURABLE_INPUT_COPY_MAX_BYTES="${TCODE_PROTEIN_RUN_DURABLE_INPUT_COPY_MAX_BYTES:-2147483648}"
TCODE_PROTEIN_RUN_DURABLE_INPUT_COPY_MAX_FILES="${TCODE_PROTEIN_RUN_DURABLE_INPUT_COPY_MAX_FILES:-4096}"

# 已确认运行在 Docker/gVisor 或等效沙箱中的 MCP 服务，支持逗号和通配符。
# 留空：没有远端 MCP 被视为已沙箱化；填写服务名：允许对应高风险 MCP 通过边界校验。
TCODE_SANDBOXED_MCP_SERVERS=

# 直接调用前必须在沙箱服务列表中声明的高风险 MCP 服务。
TCODE_SANDBOX_REQUIRED_MCP_SERVERS=*browser*,*playwright*,*chrome*,*cdp*

# 仅负责任务代理、不要求自身进入容器的 MCP 服务。
TCODE_SANDBOX_MCP_BROKER_ONLY_SERVERS=job-protocol-mcp

# 是否将 MCP 结果中的宿主机工作区路径改写为容器内路径，
# 以及是否阻断结果中泄露的工作区外宿主机路径。
# true：改写为 TCODE_SANDBOX_CONTAINER_WORKDIR；false：保留原路径。
TCODE_MCP_REWRITE_WORKSPACE_PATHS=true

# true：用阻断占位符替换工作区外宿主机路径；false：保留结果原文。
TCODE_MCP_REJECT_HOST_PATH_RESULTS=true

# ── 搜索、提示词与上下文压缩 ────────────────────────────────────

# 内置网页搜索工具使用的 SearXNG 地址。
TCODE_SEARXNG_BASE_URL=http://127.0.0.1:8888
# 按需：默认 searxng；选 brave 后需在后端环境设置 TCODE_BRAVE_SEARCH_API_KEY。
# TCODE_WEBSEARCH_PROVIDER=brave

# 是否把实际发送给模型的消息和工具定义写入本地文件。
# true：写入调试文件；false：不落盘；当前代码默认值为 false。
TCODE_DEBUG_PROMPT_DUMP=false

# OpenAI 兼容模型提供方的输入字符上限。
# 上下文引擎按约 4 个字符等于 1 个令牌估算。
TCODE_OPENAI_MAX_INPUT_CHARS=500000

# 默认将完整审计历史与单次模型输入分离；达到 token、预计延迟或重复率
# 阈值后，只向模型发送结构化检查点和最近完整回合。
# true：启用按需上下文组装；false：每次调用沿用完整会话消息。
TCODE_MODEL_CONTEXT_ASSEMBLY=true

# 会话估算令牌数达到此值时触发按需组装。
TCODE_MODEL_CONTEXT_ACTIVATION_TOKENS=24000

# 组装后模型输入的目标令牌预算，包含检查点但不包含模型输出。
TCODE_MODEL_CONTEXT_TARGET_TOKENS=32000

# 触发组装时优先保留最近多少个真实用户回合。
TCODE_MODEL_CONTEXT_RECENT_TURNS=4

# 单条用户消息进入模型上下文时最多保留的字符数。
TCODE_MODEL_CONTEXT_USER_CHARS=16000

# 单条助手或系统消息进入模型上下文时最多保留的字符数。
TCODE_MODEL_CONTEXT_ASSISTANT_CHARS=12000

# 单条工具结果进入模型上下文时最多保留的字符数。
TCODE_MODEL_CONTEXT_TOOL_CHARS=6000

# 注入模型的结构化检查点投影最多保留的字符数。
TCODE_MODEL_CONTEXT_CHECKPOINT_CHARS=18000

# 按输入吞吐估算的延迟达到此毫秒数时提前触发组装。
TCODE_MODEL_CONTEXT_MAX_PREDICTED_LATENCY_MS=4000

# 用于预测输入延迟的模型处理速度，单位为令牌/秒。
TCODE_MODEL_CONTEXT_INPUT_TOKENS_PER_SECOND=5000

# 重复内容字符占比达到此值时允许触发组装，取值范围为 0～1。
TCODE_MODEL_CONTEXT_REPETITION_RATIO=0.45

# 只有会话达到此估算令牌数后才计算重复率触发条件。
TCODE_MODEL_CONTEXT_REPETITION_MIN_TOKENS=4000

# 里程碑检查点和结构化证据投影的边界。
# 连续新增多少条工具结果后主动生成一次 tool_batch 检查点。
TCODE_CHECKPOINT_TOOL_BATCH_SIZE=3

# 每条检查点证据预览最多保留的字符数。
TCODE_CHECKPOINT_EVIDENCE_PREVIEW_CHARS=600

# 单个检查点最多保留的结构化证据条目数。
TCODE_CHECKPOINT_EVIDENCE_LIMIT=24

# 单个检查点最多保留的文件或产物引用数。
TCODE_CHECKPOINT_ARTIFACT_LIMIT=40

# 动态工具目录：普通文本请求在 MCP/Skill 发现前跳过目录，其他强意图
# 请求裁剪已准入的工具定义；未知意图保留完整目录。
# true：按当前目标裁剪工具定义；false：始终发送全部已准入工具。
TCODE_DYNAMIC_TOOL_ROUTING=true

# 工具总数达到此值后才执行目录裁剪，避免小目录产生额外判断开销。
TCODE_DYNAMIC_TOOL_ROUTING_MIN_TOOLS=12

# ── 长任务自动上下文压缩 ────────────────────────────────────────

# 是否启用接近 Codex 工作方式的整会话自动压缩：
# - true：每次模型调用前检查上下文压力，达到阈值后压缩早期历史并保留最近消息。
# - false：不做整会话自动压缩，只保留请求级上下文裁剪和超限紧急回退。
# 压缩前历史仍保留在审计事件中；前端会显示“正在压缩上下文”和完成结果。
TCODE_CONTEXT_COMPACTION_ENABLED=true

# 达到阈值后是否允许自动执行压缩：
# - true：自动压缩；false：只允许用户通过 /compact 手动压缩。
TCODE_COMPACTION_AUTO=true

# 完整压缩前是否先裁剪旧的非关键工具输出。
# true：先裁剪再判断；false：跳过裁剪直接压缩；当前代码默认值为 true。
TCODE_COMPACTION_PRUNE=true

# 模型总上下文窗口大小；当前代码默认值为 128000 个令牌。
TCODE_COMPACTION_MODEL_CONTEXT_LIMIT=128000

# 为新对话预留的令牌数，以及触发压缩前的安全缓冲区。
# 触发阈值为“上下文窗口 - 预留令牌 - 安全缓冲区”。
# 为后续用户输入和模型输出预留的令牌数。
TCODE_COMPACTION_RESERVED_TOKENS=12000

# 接近上下文上限前的安全缓冲令牌数。
TCODE_COMPACTION_BUFFER_TOKENS=12000

# 旧工具输出累计达到此值后才执行裁剪；当前代码默认值为 20000 个令牌。
TCODE_COMPACTION_PRUNE_MINIMUM_TOKENS=20000

# 优先保留最近多少令牌的工具输出；当前代码默认值为 40000。
TCODE_COMPACTION_PRUNE_PROTECT_TOKENS=40000

# 裁剪阶段默认保护的工具输出，按真实工具名精确匹配并使用逗号分隔。
# 留空：回退保护 skill 和 task；填写工具名：保护对应工具输出不被优先裁剪。
TCODE_COMPACTION_PROTECTED_TOOLS=skill,task

# 送入摘要模型的历史上下文上限，单位为估算 token；最小值为 2000。
# 超过部分从较旧消息开始省略，避免压缩请求本身再次超过模型窗口。
TCODE_COMPACTION_SUMMARY_CONTEXT_TOKENS=48000

# 单条旧消息进入摘要请求时的最大估算 token；最小值为 200。
# 值越大细节越完整，但压缩请求越大。
TCODE_COMPACTION_SUMMARY_PER_MESSAGE_TOKENS=1000

# 压缩后原样保留的最近消息数量；最小值为 2。
# 这些消息位于压缩摘要之后，保证当前任务和最近工具交互不被摘要替代。
TCODE_COMPACTION_RECENT_KEEP_MESSAGES=6

# 压缩后每条最近消息允许保留的最大估算 token；最小值为 500。
# 超过后只裁剪该条消息副本，不影响审计事件中的原始记录。
TCODE_COMPACTION_RECENT_MESSAGE_TOKENS=4000

# ── 企业认证 ────────────────────────────────────────────────────

# 企业模式要求业务接口和 /ws/chat 先完成登录；设为 0 时使用本地单用户模式。
# 1：企业认证模式；0：本地兼容模式；当前代码默认值为 1。
TCODE_ENTERPRISE_MODE=1

# 旧版认证开关，仅在未设置 TCODE_ENTERPRISE_MODE 时作为兼容回退。
# 1：要求登录；0：不要求登录；当前值与企业模式保持一致。
TCODE_AUTH_REQUIRED=1

# 首次启动且认证数据库中没有用户时自动创建的管理员账号。
# 认证数据库已有用户后，修改这里不会重置原密码。
# 管理员登录邮箱。
TCODE_BOOTSTRAP_EMAIL=admin@example.com

# 管理员初始密码；生产部署应替换为强密码。
TCODE_BOOTSTRAP_PASSWORD=${TCODE_BOOTSTRAP_PASSWORD:-admin123456}

# 管理员用户标识。
TCODE_BOOTSTRAP_USER_ID=admin

# 认证库为空时，Bootstrap 管理员会自动加入该默认租户并成为 Owner。
# 未显式传递租户、用户或 Workspace 声明的本地 Agent/TMCP 请求也使用该默认范围。
# tenant_id、user_id 和 workspace_id 最终组成 workdirs/<tenant_id>/<user_id>/<workspace_id>。
# 这些 ID 只允许字母、数字、点、下划线、@ 和连字符；租户 ID 创建后不可修改。
TCODE_DEFAULT_TENANT_ID=admin_tenant
TCODE_DEFAULT_USER_ID=local-user
TCODE_DEFAULT_WORKSPACE_ID=workspace-1

# 可选：Workspace 存储根目录，不包含 tenant_id/user_id/workspace_id 三层。
# 留空：使用 <TCODE_WORKDIR>/workdirs；填写绝对路径时例如 /srv/tcode/workspaces，
# 最终路径为 /srv/tcode/workspaces/<tenant_id>/<user_id>/<workspace_id>。
TCODE_USER_WORKDIRS_ROOT=

# 内部工作节点和边车进程访问任务跟踪器时使用的令牌。
# 留空：仅允许已登录 Web 用户访问 tracker；start_web.sh 会为同进程 worker 生成临时令牌。
# 配置示例：TCODE_TRACKER_API_TOKEN=change-me
TCODE_TRACKER_API_TOKEN=${TCODE_TRACKER_API_TOKEN:-}
# Web 与独立启动的 Symphony/adapter 通过该文件共享同一服务令牌。
# 相对路径统一按 tcode 项目根解析，便于 macOS/Linux 迁移。
TCODE_TRACKER_API_TOKEN_FILE=${TCODE_TRACKER_API_TOKEN_FILE:-tmp/tracker-api.token}

# ── TMCP 外部 Agent 工作区路径适配 ─────────────────────────────

# 以下两个配置均为可选项。OpenClaw 或其他 Agent 传入的 workspace_root
# 在 TMCP 服务器上可直接访问，且位于当前允许的工作区范围内时，无需额外配置。

# 客户端路径前缀到 TMCP 服务端路径前缀的映射，值必须是有效的 JSON。
# 适用场景：客户端容器与 TMCP 服务器访问的是同一个共享目录，但两边看到的绝对路径不同。
# JSON 的 key 是 Agent 传入的客户端绝对路径前缀，value 是 TMCP 进程实际可访问的
# 服务端路径前缀；value 可以写成相对 TMCP 项目根的路径。
#
# TMCP 只替换匹配的路径前缀，后面的 workspace_id、任务目录和动态子目录会原样保留，
# 因此不需要为每个任务单独配置。多条规则同时匹配时，优先使用最长、最具体的前缀。
#
# 示例：OpenClaw 传入
# /home/node/.openclaw/dovetail/workspace/default/task-001，
# 而同一个目录在 TMCP 服务器上挂载为
# /data/openclaw-workspace/default/task-001。
# TMCP_WORKSPACE_PATH_MAPPINGS='{"/home/node/.openclaw/dovetail/workspace":"/data/openclaw-workspace"}'
#
# 多个 Agent 或容器路径前缀可以写在同一个 JSON 对象中：
# TMCP_WORKSPACE_PATH_MAPPINGS='{"/home/node/.openclaw/dovetail/workspace":"/data/openclaw-workspace","/agent/workspaces":"/data/agent-workspaces"}'
#
# 留空：优先通过 issuer/tenant/subject/workspace_id 在服务端解析工作区；只有兼容旧
# Agent 时才需要传入绝对 workspace_root。
# 注意：该配置只负责转换路径字符串，不会挂载、复制或同步文件。
# 映射目标必须已挂载到 TMCP 服务器，并且 TMCP 运行用户拥有相应访问权限。
TMCP_WORKSPACE_PATH_MAPPINGS="${TMCP_WORKSPACE_PATH_MAPPINGS:-}"

# TMCP 是多 Agent 共用服务。issuer 根目录和路径映射都可以使用相对 TMCP
# 项目根的路径；生产环境建议在网关签发 workspace_grant 后切换到 signed。
TMCP_AUTH_MODE="${TMCP_AUTH_MODE:-compat}"
TMCP_DEFAULT_ISSUER="${TMCP_DEFAULT_ISSUER:-tcode}"
TMCP_DEFAULT_AGENT_ID="${TMCP_DEFAULT_AGENT_ID:-tcode-agent}"
TMCP_ISSUER_WORKSPACE_ROOTS="${TMCP_ISSUER_WORKSPACE_ROOTS:-}"
TMCP_WORKSPACE_GRANT_SECRET="${TMCP_WORKSPACE_GRANT_SECRET:-}"

# Job Protocol 状态存放在 TMCP 安装目录下，不再依赖运行用户的 HOME。
TMCP_JOB_REGISTRY_DIR="${TMCP_JOB_REGISTRY_DIR:-var/jobs}"
# 独立 TMCP 的默认地址文件由 runner 自行解析；TCode 的 local.env 默认复用执行端配置。
# 可显式设置 TMCP_TARGET_SERVER_CONFIG 覆盖，不在此提前填入旧默认值。
TMCP_JOB_AUTH_MODE="${TMCP_JOB_AUTH_MODE:-compat}"
TMCP_ALLOW_SNAPSHOT_WORKSPACE_ROOT_FALLBACK="${TMCP_ALLOW_SNAPSHOT_WORKSPACE_ROOT_FALLBACK:-0}"
# 计算型 MCP 的统一提交授权策略：
# - job-protocol-only：所有调用方只能使用 Job Protocol；
# - capability：Job Protocol 正常放行，外部 Agent 还可凭经过认证的
#   mcp:direct capability 直连（推荐用于多 Agent 部署）；
# - direct：兼容旧部署，允许直连；只应在受信网络中使用。
# capability 模式需要 TMCP_AUTH_MODE=claims（受信网关）或 signed
#（workspace_grant）；权限还可收窄为 mcp:direct:<server>[:<tool>]。
# TMCP_COMPUTE_SUBMISSION_POLICY="${TMCP_COMPUTE_SUBMISSION_POLICY:-capability}"
TMCP_COMPUTE_SUBMISSION_POLICY=direct
# 当前可信局域网部署中，领域 MCP 使用 direct 策略并由 HTTP 服务层限制访问。
# Job Protocol 与领域 MCP 分机运行且尚未共享 broker 密钥，因此不注入会被
# 远端判为无效的 broker token。未来启用 capability/job-protocol-only 时，
# 必须先在两台机器配置相同 TMCP_BROKER_SECRET，再将本项改回 true。
TMCP_JOB_PROTOCOL_INJECT_BROKER_TOKEN=false
# 旧版开关仅在没有设置 TMCP_COMPUTE_SUBMISSION_POLICY 时生效，继续保留
# 以兼容独立部署的旧环境。启动脚本会在 tcode/runs 下生成共享 broker 密钥。
TMCP_REQUIRE_JOB_PROTOCOL="${TMCP_REQUIRE_JOB_PROTOCOL:-true}"
TMCP_BROKER_SECRET="${TMCP_BROKER_SECRET:-}"
TMCP_BROKER_SECRET_FILE="${TMCP_BROKER_SECRET_FILE:-runs/mcp_broker_secret}"

# 旧 command 字符串可执行任意 shell，只用于显式开启的迁移窗口。
TMCP_ALLOW_LEGACY_COMMAND_JOBS="${TMCP_ALLOW_LEGACY_COMMAND_JOBS:-0}"

# TMCP 允许作为 workspace_root 使用的服务端目录根列表。
# 这里必须填写“路径映射之后”、TMCP 服务器实际看到的路径，
# 不能填写只存在于 OpenClaw 或其他 Agent 容器内的客户端路径。
# TMCP 会先进行路径映射，再使用本配置执行允许范围校验。
#
# 可以配置一个或多个根目录；多个值支持英文逗号、Linux 冒号或换行分隔。
# workspace_root 必须等于其中某个根目录，或者位于该根目录的子目录中。
#
# 单个根目录示例：
# TMCP_ALLOWED_WORKSPACE_ROOTS=/data/openclaw-workspace
#
# 多个根目录示例，同时允许 OpenClaw、其他 Agent 和 TCode 管理的工作区：
# TMCP_ALLOWED_WORKSPACE_ROOTS=/data/openclaw-workspace,/data/agent-workspaces,/srv/tcode/workspaces
#
# 留空：TMCP 继续使用现有默认范围；优先回退到 TCODE_USER_WORKDIRS_ROOT，
# 未配置时再回退到 TCODE_SANDBOX_WORKSPACE_ROOT。
# 注意：通过范围校验不等于拥有操作系统权限。目录必须存在且确实是目录，
# TMCP 运行用户仍需对目录及相关子目录拥有必要的读取、写入和进入权限。
TMCP_ALLOWED_WORKSPACE_ROOTS="${TMCP_ALLOWED_WORKSPACE_ROOTS:-}"

# ── Paper Wiki 同租户只读共享 ────────────────────────────────────
# 以下配置都可以不写；不配置时使用代码中的安全默认值。
#
# Wiki 共享授权数据库。这里只保存 tenant_id/user_id/workspace_id、授权范围和审计事件，
# 不保存绝对 Workspace 路径，也不会复制 Wiki 文件。
# 留空：使用 <TCODE_WORKDIR>/.tcode/wiki_shares.sqlite3。
# 生产示例：TCODE_WIKI_SHARES_DB=/var/lib/tcode/wiki_shares.sqlite3
TCODE_WIKI_SHARES_DB="${TCODE_WIKI_SHARES_DB:-}"

# 受信任外部 Agent 调用 /api/paper-wiki/service/* 时使用的固定 Token。
# 留空或少于 24 个字符：服务账号接口保持关闭；Web 登录用户不受影响。
# 生产环境必须从密钥系统注入至少 32 字节随机值，不要把真实 Token 提交到仓库。
# 请求可使用 X-Wiki-Service-Token，也可使用 Authorization: Bearer <token>。
# 示例（仅说明格式）：TCODE_WIKI_SERVICE_TOKEN=replace-with-32-byte-random-secret
TCODE_WIKI_SERVICE_TOKEN="${TCODE_WIKI_SERVICE_TOKEN:-}"

# 一次“我的 Wiki + 全部可访问共享 Wiki”检索最多展开的共享来源数。
# 默认 24，允许 1–64；超过上限的来源不会在本次请求展开，以避免 MVP 阶段卡死。
TCODE_WIKI_SEARCH_MAX_SOURCES="${TCODE_WIKI_SEARCH_MAX_SOURCES:-24}"

# 同时查询多少个共享 Wiki 来源。默认 4，允许 1–12。
TCODE_WIKI_SEARCH_CONCURRENCY="${TCODE_WIKI_SEARCH_CONCURRENCY:-4}"

# 单个来源的超时秒数。默认 1.5，允许 0.2–5；超时来源会被跳过并返回 partial=true。
TCODE_WIKI_SEARCH_SOURCE_TIMEOUT_SECONDS="${TCODE_WIKI_SEARCH_SOURCE_TIMEOUT_SECONDS:-1.5}"

# 一次共享来源扇出查询的总等待秒数。默认 3，允许 0.5–10。
# 该上限不包含当前用户自己的 Wiki 查询时间。
TCODE_WIKI_SEARCH_TOTAL_TIMEOUT_SECONDS="${TCODE_WIKI_SEARCH_TOTAL_TIMEOUT_SECONDS:-3}"


# 嵌入策略：model_first 优先调用模型，失联/超时/坏响应时回退本地哈希；local_only 完全不调用模型。
# 此项优先于旧 TCODE_LOCAL_EMBEDDING_ENABLED；修改后重启后端。不会自动迁移或全量重建已有索引。
TCODE_EMBEDDING_STRATEGY="${TCODE_EMBEDDING_STRATEGY:-model_first}"
# 以下留空沿用当前 Workspace 的 tcode.json；填写后由这个文件统一覆盖模型配置。
# 当前记忆/研究检索支持 ollama。示例：provider=ollama，model=bge-m3，base_url=http://127.0.0.1:11434。
TCODE_EMBEDDING_PROVIDER="${TCODE_EMBEDDING_PROVIDER:-}"
TCODE_EMBEDDING_MODEL="${TCODE_EMBEDDING_MODEL:-}"
# 模型权重/部署版本标识，可选；同名模型更换权重时更新此值，再明确执行向量迁移。
TCODE_EMBEDDING_REVISION="${TCODE_EMBEDDING_REVISION:-}"
TCODE_EMBEDDING_BASE_URL="${TCODE_EMBEDDING_BASE_URL:-}"
# 文档语义候选的最低余弦相似度，低于阈值不强凑结果；需用实际模型评测调整，不是正确率保证。
TCODE_EMBEDDING_MIN_SIMILARITY="${TCODE_EMBEDDING_MIN_SIMILARITY:-0.35}"
# 服务不可用后的重试冷却秒数，期间直接走本地降级，避免每次查询重复超时。
TCODE_EMBEDDING_UNAVAILABLE_COOLDOWN_SECONDS="${TCODE_EMBEDDING_UNAVAILABLE_COOLDOWN_SECONDS:-120}"
# 外部嵌入请求的最长等待秒数。
TCODE_EMBEDDING_HTTP_TIMEOUT_SECONDS=30


# 每个用户最多允许拥有的有效 Workspace 数量；已软删除的 Workspace 不计入，恢复时会重新校验额度。
# 必须设置为大于 0 的整数，修改后需要重启 Web 服务；未设置或无效时使用安全默认值 5。
TCODE_MAX_WORKSPACES_PER_USER="${TCODE_MAX_WORKSPACES_PER_USER:-5}"

# 多 Artifact：也可通过前端“设置 → 远端服务”保存配置，重启后生效。
# 下列为可选配置，不设置时沿用原单地址。令牌值独立放在 token_env 指定的变量中。
# TMCP_ARTIFACT_SERVICE_ID=store-a
# TMCP_ARTIFACT_SERVICES='{"store-a":{"url":"https://artifacts-a.example.com","token_env":"ARTIFACT_A_TOKEN"},"store-b":{"url":"https://artifacts-b.example.com","token_env":"ARTIFACT_B_TOKEN"}}'
# TMCP_ARTIFACT_TARGET_SERVICES='{"compute-a-mcp":"store-a","compute-b-mcp":"store-b"}'
# 计算 MCP 也需配置它要读取的服务；引用中仅保存 service_id，不保存地址/令牌。
