# 生产环境配置入口：复制为 config/sandbox_production.env，并替换其中所有路径和密钥。
# 本文件先加载公共基础配置，下面的生产值会覆盖同名基础配置。
# Web、后台 Server、Sandbox Runner 和 TMCP 均使用 TCODE_ENV_FILE 指向复制后的文件。
#
# Web 服务配置。Web 系统用户不能属于 docker 组，也不能挂载或读取
# /var/run/docker.sock。

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/templates/symphony_route.env.example"

TCODE_ENTERPRISE_MODE=true
TCODE_AUTH_REQUIRED=true
TCODE_BOOTSTRAP_EMAIL=admin@example.com
# 请从密钥管理系统注入该值，不要提交真实密码。
TCODE_BOOTSTRAP_PASSWORD=
TCODE_BOOTSTRAP_USER_ID=admin
# 首次启动会创建该租户并让 Bootstrap 管理员成为 Owner；无身份声明的受信任调用也使用它。
TCODE_DEFAULT_TENANT_ID=admin_tenant
TCODE_DEFAULT_USER_ID=local-user
TCODE_DEFAULT_WORKSPACE_ID=workspace-1
# 每个用户最多允许拥有的有效 Workspace 数量；已软删除的 Workspace 不计入，恢复时会重新校验额度。
# 必须设置为大于 0 的整数，修改后需要重启 Web 服务。
TCODE_MAX_WORKSPACES_PER_USER=5
# 最终目录：/srv/tcode/workspaces/<tenant_id>/<user_id>/<workspace_id>。
TCODE_USER_WORKDIRS_ROOT=/srv/tcode/workspaces
# 为空时 start_web.sh 会为同进程后台 worker 生成临时值；外置 worker 必须从密钥系统注入固定随机 Token。
TCODE_TRACKER_API_TOKEN=
# Workspace 软删除状态库。生产必须放到持久目录，并保证 Web 服务账号可读写。
TCODE_WORKSPACE_STATE_DB=/var/lib/tcode/workspaces.sqlite3

TCODE_SANDBOX_ENABLED=true
TCODE_ISOLATION_MODE=strict
TCODE_SANDBOX_MODE=runtime
TCODE_SANDBOX_REQUIRE_RUNNER=true
TCODE_SANDBOX_RUNNER_URL=http://127.0.0.1:19091
TCODE_BROWSER_REQUIRE_RUNNER=true
TCODE_BROWSER_ALLOWED_AGENTS=browser
TCODE_SKILL_AGENT_BINDINGS=agent-browser:browser
TCODE_SKILL_SANDBOX_PROFILE_BINDINGS=agent-browser:browser
TCODE_SANDBOX_RUNNER_TOKEN_FILE=/etc/tcode/sandbox-runner.token
TCODE_SANDBOX_BACKEND=docker-gvisor
TCODE_SANDBOX_DOCKER_RUNTIME=runsc
TCODE_SANDBOX_USER=10000:10000
TCODE_SANDBOX_HOME=/tmp/home
TCODE_SANDBOX_READ_ONLY=true

# 未知社区插件必须由 Sandbox Runner 启动独立 Docker 容器；生产环境禁止
# 回退到 macOS sandbox-exec 或 Linux bwrap 本机进程。
TCODE_PLUGIN_ISOLATION_BACKEND=container
TCODE_PLUGIN_CONTAINER_IMAGE=tcode-plugin-runtime:py312
TCODE_PLUGIN_CONTAINER_USER=65532:65532
TCODE_PLUGIN_CONTAINER_MEMORY=768m
TCODE_PLUGIN_CONTAINER_CPUS=1
TCODE_PLUGIN_CONTAINER_MAX_WORKERS=32
# Runner 只允许把这些目录下的单个插件包以只读方式挂载进容器。
TCODE_PLUGIN_RUNNER_ALLOWED_PLUGIN_ROOTS=/srv/tcode/tcode/plugins,/srv/tcode/community-plugins
TCODE_PLUGIN_TOOL_TIMEOUT_SECONDS=600
TCODE_PLUGIN_MAX_DELEGATED_CALLS=16
TCODE_PLUGIN_MAX_DELEGATION_DEPTH=3

# Web 与 runner 共用的安全策略。
TCODE_SANDBOX_WORKSPACE_ROOT=/srv/tcode/workspaces
# 生产环境禁止文件工具直接读取 workspace 外宿主机路径；外部资源必须通过受控导入或只读挂载。
TCODE_WORKSPACE_IO_ALLOW_EXTERNAL_READ=false
TCODE_WORKSPACE_IO_ALLOW_EXTERNAL_WRITE=false
# Agent 不应看到平台运行记录和密钥文件；这些路径在文件工具中不可见，在命令容器中使用空内容遮蔽。
TCODE_SANDBOX_WORKSPACE_HIDDEN_PATHS=.tcode,.tcode-local,.env,config/local.env,config/sandbox_production.env,config/mcp_host.env
# Agent 可以读取仓库和平台配置用于理解项目，但不能在运行会话中改写它们。
TCODE_SANDBOX_WORKSPACE_READ_ONLY_PATHS=.git,tcode.json,plugins.json,mcp.json,sandbox_runner_tool_policy.json,mcp_job_protocol_only.json
# 空内容遮蔽目录必须由 Sandbox Runner 独占，并且必须位于任何用户 workspace 之外。
TCODE_SANDBOX_WORKSPACE_MASK_ROOT=/var/lib/tcode-sandbox-runner/workspace-masks
TCODE_SANDBOX_DEFAULT_NETWORK=none
TCODE_SANDBOX_NETWORK_ALLOWED_TOOLS=browser,webfetch,websearch
TCODE_SANDBOX_ALLOWED_NETWORK=egress
TCODE_BROWSER_SANDBOX_NETWORK=egress
TCODE_SANDBOX_EGRESS_PROXY=http://egress-proxy:3128
TCODE_SANDBOX_EGRESS_PROXY_CONTAINER=tcode-egress-proxy
TCODE_SANDBOX_WORKSPACE_SNAPSHOTS=true
TCODE_SANDBOX_SNAPSHOT_ROOT=/var/lib/tcode-sandbox-runner/snapshots
TCODE_SANDBOX_CONFLICT_ROOT=/var/lib/tcode-sandbox-runner/conflicts
TCODE_SANDBOX_JOB_LOG_ROOT=/var/lib/tcode-sandbox-runner/logs
TCODE_SANDBOX_LOG_MAX_SIZE=100m
TCODE_SANDBOX_LOG_MAX_FILES=3
TCODE_SANDBOX_WORKSPACE_SERVICE_POLICY_FILE=/etc/tcode/sandbox-workspace-services.json
# 管理员维护的只读软件和数据库挂载，可供命令沙盒共享。
# TCODE_SANDBOX_STATIC_RESOURCES_FILE=/etc/tcode/sandbox-static-resources.json

# Runner 专用配置。请使用独立系统用户启动 scripts/start_sandbox_runner.sh，
# 并且只允许该用户访问 Docker。
TCODE_SANDBOX_RUNNER_REQUIRE_TOKEN=true
TCODE_SANDBOX_RUNNER_REQUIRED_RUNTIME=runsc
TCODE_SANDBOX_RUNNER_REQUIRE_SNAPSHOTS=true
TCODE_SANDBOX_RUNNER_REQUIRE_OWNER_METADATA=true
TCODE_SANDBOX_RUNNER_WORKSPACE_ROOT=/srv/tcode/workspaces
TCODE_SANDBOX_RUNNER_ALLOWED_IMAGES=tcode-executor:py312,tcode-browser:playwright,tcode-tools-blast:latest

# Runner 允许接收的工具。skill_run 是所有可执行 Skill action 的统一入口。
TCODE_SANDBOX_RUNNER_ALLOWED_TOOLS=bash,exec,read,write,edit,glob,grep,browser,skill_run,plugin_runtime,plugin_network,plugin:*

# Runner 允许采用的网络模式；具体工具能使用哪一种网络由下方策略文件进一步限制。
TCODE_SANDBOX_RUNNER_ALLOWED_NETWORKS=none,internal,egress
# Runner 允许的容器用户精确列表，英文逗号分隔；普通 UID:GID 与 root profile 的 0:0 都必须列出。
TCODE_SANDBOX_RUNNER_ALLOWED_USERS=10000:10000,0:0
# 以下两个开关只是能力上限；实际 root 仍必须通过认证 user_id 白名单、profile 和工具策略校验。
TCODE_SANDBOX_RUNNER_ALLOW_CONTAINER_ROOT=true
TCODE_SANDBOX_RUNNER_ALLOW_WRITABLE_ROOT=true
# root Runtime 总开关。true：启用按认证 user_id 路由；false：所有用户均使用普通非 root Runtime。
TCODE_SANDBOX_ROOT_RUNTIME_ENABLED=true

# 容器 root 白名单，填写 /api/auth/me 返回的 user.user_id；不要填写邮箱或 Agent 名称。
# 多个 ID 使用英文逗号分隔，例如：admin,user-001,user-002。生产环境必须显式填写真实用户 ID。
# 该白名单只控制容器 root 权限，不会授予后台 admin/owner 角色。
TCODE_SANDBOX_ROOT_RUNTIME_USER_IDS=

# 白名单用户最终使用的 sandbox profile；必须对应 tcode.json 中 persistent + 0:0 + read_only=false 的 profile。
TCODE_SANDBOX_ROOT_RUNTIME_PROFILE=workspace_root_runtime

# 可自动升级的普通 profile 名称列表，英文逗号分隔；名称必须存在于 tcode.json。
# 当前建议值：workspace_runtime、executor、networked、default。不要加入 browser、blast_tools 或 MCP 专用 profile。
TCODE_SANDBOX_ROOT_RUNTIME_BASE_PROFILES=workspace_runtime,executor,networked,default

# skill_run 会把入口脚本以只读方式挂载进沙盒，只允许可信 Skill、插件和数据库目录。
TCODE_SANDBOX_RUNNER_ALLOWED_MOUNT_ROOTS=/srv/tcode/imports,/srv/tcode/tcode/.claude/skills,/srv/tcode/tcode/plugins,/srv/tcode/resources/blastp/uniref100
# 公共只读程序/数据库可以跨任务挂载；用户输入只允许 imports/<tenant>/<user>/<workspace>。
TCODE_SANDBOX_RUNNER_TRUSTED_MOUNT_ROOTS=/srv/tcode/tcode/.claude/skills,/srv/tcode/tcode/plugins,/srv/tcode/resources/blastp/uniref100

# 按“工具 + capability”限制镜像与网络。部署时将仓库中的
# config/templates/sandbox_runner_tool_policy.example.json 安装到此路径。
TCODE_SANDBOX_RUNNER_TOOL_POLICY_FILE=/etc/tcode/sandbox-runner-tool-policy.json
TCODE_SANDBOX_RUNNER_MAX_TIMEOUT_SECONDS=2592000
TCODE_SANDBOX_RUNNER_MAX_MEMORY=8g
TCODE_SANDBOX_RUNNER_MAX_CPUS=8
TCODE_SANDBOX_RUNNER_MAX_PIDS=512
TCODE_SANDBOX_RUNNER_MAX_SHM_SIZE=2g
TCODE_SANDBOX_RUNNER_STATE_FILE=/var/lib/tcode-sandbox-runner/jobs.json
# 常驻 Runtime 的 SQLite Registry；必须放在持久化目录，代码会将数据库权限收紧为 0600。
TCODE_SANDBOX_RUNTIME_STATE_FILE=/var/lib/tcode-sandbox-runner/runtimes.sqlite
# 大于 0：空闲达到该秒数后 stop；0：不因空闲自动 stop。
TCODE_SANDBOX_RUNTIME_IDLE_STOP_SECONDS=3600
# 大于 0：stop 达到该秒数后删除容器但保留 Runtime HOME；604800 等于 7 天；0 表示永不自动删除。
TCODE_SANDBOX_RUNTIME_RETENTION_SECONDS=604800
TCODE_SANDBOX_RUNNER_REAPER_INTERVAL_SECONDS=2

# ── Paper Wiki 同租户只读共享 ────────────────────────────────────
# 以下配置都可以不写；不配置时使用代码中的安全默认值。
#
# Wiki 共享授权数据库。这里只保存 tenant_id/user_id/workspace_id、授权范围和审计事件，
# 不保存绝对 Workspace 路径，也不会复制 Wiki 文件。
# 留空：使用 <TCODE_WORKDIR>/.tcode/wiki_shares.sqlite3。
# 生产示例：TCODE_WIKI_SHARES_DB=/var/lib/tcode/wiki_shares.sqlite3
TCODE_WIKI_SHARES_DB="${TCODE_WIKI_SHARES_DB:-}"

# 受信任外部 Agent 调用 /api/paper-wiki/service/* 时使用的固定 Token。
# 留空或少于 24 个字符：服务账号接口保持关闭；Web 登录用户不受影响。
# 生产环境必须从密钥系统注入至少 32 字节随机值，不要把真实 Token 提交到仓库。
# 请求可使用 X-Wiki-Service-Token，也可使用 Authorization: Bearer <token>。
# 示例（仅说明格式）：TCODE_WIKI_SERVICE_TOKEN=replace-with-32-byte-random-secret
TCODE_WIKI_SERVICE_TOKEN="${TCODE_WIKI_SERVICE_TOKEN:-}"

# 一次“我的 Wiki + 全部可访问共享 Wiki”检索最多展开的共享来源数。
# 默认 24，允许 1–64；超过上限的来源不会在本次请求展开，以避免 MVP 阶段卡死。
TCODE_WIKI_SEARCH_MAX_SOURCES="${TCODE_WIKI_SEARCH_MAX_SOURCES:-24}"

# 同时查询多少个共享 Wiki 来源。默认 4，允许 1–12。
TCODE_WIKI_SEARCH_CONCURRENCY="${TCODE_WIKI_SEARCH_CONCURRENCY:-4}"

# 单个来源的超时秒数。默认 1.5，允许 0.2–5；超时来源会被跳过并返回 partial=true。
TCODE_WIKI_SEARCH_SOURCE_TIMEOUT_SECONDS="${TCODE_WIKI_SEARCH_SOURCE_TIMEOUT_SECONDS:-1.5}"

# 一次共享来源扇出查询的总等待秒数。默认 3，允许 0.5–10。
# 该上限不包含当前用户自己的 Wiki 查询时间。
TCODE_WIKI_SEARCH_TOTAL_TIMEOUT_SECONDS="${TCODE_WIKI_SEARCH_TOTAL_TIMEOUT_SECONDS:-3}"

# ── 第二阶段：执行容量、引导队列与遥测反压 ──────────────────────
# 主会话和 Worker 共用同一套预算；达到并发上限后进入有界等待队列。
TCODE_EXECUTION_MAX_CONCURRENT_GLOBAL="${TCODE_EXECUTION_MAX_CONCURRENT_GLOBAL:-16}"
TCODE_EXECUTION_MAX_CONCURRENT_PER_USER="${TCODE_EXECUTION_MAX_CONCURRENT_PER_USER:-4}"
TCODE_EXECUTION_MAX_CONCURRENT_PER_SESSION="${TCODE_EXECUTION_MAX_CONCURRENT_PER_SESSION:-1}"
TCODE_EXECUTION_QUEUE_MAX_GLOBAL="${TCODE_EXECUTION_QUEUE_MAX_GLOBAL:-64}"
TCODE_EXECUTION_QUEUE_MAX_PER_USER="${TCODE_EXECUTION_QUEUE_MAX_PER_USER:-12}"
TCODE_EXECUTION_QUEUE_MAX_PER_SESSION="${TCODE_EXECUTION_QUEUE_MAX_PER_SESSION:-1}"
# 等待超过该秒数会明确返回 capacity.wait_timeout，不会无限挂起。
TCODE_EXECUTION_QUEUE_WAIT_SECONDS="${TCODE_EXECUTION_QUEUE_WAIT_SECONDS:-30}"

# 用户或 Agent 追加的引导消息同时受会话级和全局硬上限约束。
TCODE_GUIDANCE_QUEUE_MAX_PER_SESSION="${TCODE_GUIDANCE_QUEUE_MAX_PER_SESSION:-32}"
TCODE_GUIDANCE_QUEUE_MAX_GLOBAL="${TCODE_GUIDANCE_QUEUE_MAX_GLOBAL:-512}"

# Guidance v2 按层灰度；生产示例默认全部关闭。Redis 只负责跨进程唤醒，SQLite 仍是权威存储。
TCODE_STEER_V2_ENABLED="${TCODE_STEER_V2_ENABLED:-0}"
TCODE_STEER_MODEL_INTERRUPT_ENABLED="${TCODE_STEER_MODEL_INTERRUPT_ENABLED:-0}"
TCODE_STEER_TOOL_INTERRUPT_ENABLED="${TCODE_STEER_TOOL_INTERRUPT_ENABLED:-0}"
TCODE_STEER_DESCENDANT_POLICY_ENABLED="${TCODE_STEER_DESCENDANT_POLICY_ENABLED:-0}"
TCODE_OUTCOME_REVISION_PLANNER_ENABLED="${TCODE_OUTCOME_REVISION_PLANNER_ENABLED:-0}"
TCODE_GUIDANCE_NOTIFY_BACKEND="${TCODE_GUIDANCE_NOTIFY_BACKEND:-auto}"
TCODE_GUIDANCE_REDIS_URL="${TCODE_GUIDANCE_REDIS_URL:-}"
TCODE_GUIDANCE_POLL_INTERVAL_MS="${TCODE_GUIDANCE_POLL_INTERVAL_MS:-250}"
TCODE_GUIDANCE_CLAIM_LEASE_SECONDS="${TCODE_GUIDANCE_CLAIM_LEASE_SECONDS:-30}"
TCODE_GUIDANCE_CLASSIFY_TIMEOUT_SECONDS="${TCODE_GUIDANCE_CLASSIFY_TIMEOUT_SECONDS:-12}"
TCODE_GUIDANCE_BATCH_MAX_ITEMS="${TCODE_GUIDANCE_BATCH_MAX_ITEMS:-8}"
TCODE_GUIDANCE_BATCH_WINDOW_MS="${TCODE_GUIDANCE_BATCH_WINDOW_MS:-100}"
TCODE_GUIDANCE_MODEL_CANCEL_TIMEOUT_SECONDS="${TCODE_GUIDANCE_MODEL_CANCEL_TIMEOUT_SECONDS:-2}"

# 遥测 exporter 是可选项；启用后也只能通过有界队列异步接收脱敏数据。
TCODE_TELEMETRY_QUEUE_MAX="${TCODE_TELEMETRY_QUEUE_MAX:-1000}"
TCODE_TELEMETRY_BATCH_SIZE="${TCODE_TELEMETRY_BATCH_SIZE:-20}"
