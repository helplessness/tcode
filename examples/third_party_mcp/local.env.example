# Merge into the user's private environment; do not overwrite existing local.env.
TMCP_JOB_PROTOCOL_HOST=127.0.0.1
TMCP_JOB_PROTOCOL_PORT=10121
TCODE_PLUGIN_JOB_PROTOCOL_URL=http://127.0.0.1:10121
# Replace with an Artifact endpoint reachable by both TCode and the remote service.
TMCP_ARTIFACT_SERVICE_URL=https://artifact.example.org
# Optional: use a dedicated shared management token instead of the start script's
# automatically generated .tcode-local/target-registry.token.
# TMCP_TARGET_REGISTRY_TOKEN=<generate-a-random-secret-and-configure-both-processes>
# Bearer token for your provider, NOT an LLM or platform API key:
# TCODE_PLUGIN_TOKEN_DEMO=<same-value-as-remote-EXAMPLE_MCP_TOKEN>

# Directory upload defaults (bytes / file count):
TCODE_PLUGIN_UPLOAD_MAX_BYTES=524288000
TCODE_PLUGIN_UPLOAD_MAX_FILES=10000
