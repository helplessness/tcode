{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PaperResearchPluginConfig",
  "type": "object",
  "properties": {
    "workspace_dir": {"type": "string"},
    "auto_bootstrap": {"type": "boolean"},
    "default_max_results": {"type": "integer", "minimum": 1},
    "auto_resolve_pdf_links": {"type": "boolean"},
    "auto_download_pdf_files": {"type": "boolean"},
    "browser_pdf_fallback_enabled": {"type": "boolean"},
    "browser_pdf_fallback_limit": {"type": "integer", "minimum": 0},
    "browser_pdf_fallback_timeout_seconds": {"type": "integer", "minimum": 1},
    "pdf_enrichment_limit": {"type": "integer", "minimum": 0},
    "pdf_download_subdir": {"type": "string"},
    "library_auto_escalate_on_insufficient_evidence": {"type": "boolean"},
    "library_chunk_max_chars": {"type": "integer", "minimum": 1},
    "library_chunk_overlap_chars": {"type": "integer", "minimum": 0},
    "library_allow_cross_page_chunks": {"type": "boolean"},
    "library_paragraph_summary_max_chars": {"type": "integer", "minimum": 1},
    "library_query_candidate_doc_limit": {"type": "integer", "minimum": 1},
    "library_query_candidate_passage_limit": {"type": "integer", "minimum": 1},
    "library_query_evidence_limit": {"type": "integer", "minimum": 1},
    "library_evidence_context_max_records": {"type": "integer", "minimum": 1, "maximum": 2000},
    "library_evidence_ensure_max_references": {"type": "integer", "minimum": 1, "maximum": 2000},
    "library_query_candidate_doc_score_threshold": {"type": "number", "minimum": 0},
    "library_query_candidate_doc_max_hits": {"type": "integer", "minimum": 1},
    "library_query_limit_docs_max": {"type": "integer", "minimum": 1},
    "library_query_limit_evidence_max": {"type": "integer", "minimum": 1},
    "library_render_page_images": {"type": "boolean"},
    "library_render_table_images": {"type": "boolean"},
    "library_render_figure_images": {"type": "boolean"},
    "library_visual_image_dpi": {"type": "integer", "minimum": 1},
    "library_visual_image_max_dim": {"type": "integer", "minimum": 1},
    "library_visual_table_padding_px": {"type": "integer", "minimum": 0},
    "library_visual_figure_min_dim": {"type": "integer", "minimum": 1},
    "library_visual_figure_min_area": {"type": "integer", "minimum": 1},
    "library_visual_max_pages": {"type": "integer", "minimum": 0},
    "library_visual_model_max_images": {"type": "integer", "minimum": 1, "maximum": 2},
    "library_wiki_enabled": {"type": "boolean"},
    "library_wiki_compile_after_ingest": {"type": "boolean"},
    "library_wiki_auto_approve_new_pages": {"type": "boolean"},
    "library_wiki_require_human_review": {"const": true},
    "library_wiki_auto_apply": {"const": false},
    "library_wiki_require_evidence": {"type": "boolean"},
    "library_wiki_max_pages_per_compile": {"type": "integer", "minimum": 1},
    "library_wiki_query_page_limit": {"type": "integer", "minimum": 1},
    "library_wiki_lint_after_apply": {"type": "boolean"},
    "library_wiki_regeneration_enabled": {"type": "boolean"},
    "library_wiki_markdown_sync_enabled": {"type": "boolean"},
    "library_wiki_markdown_sync_interval_seconds": {"type": "integer", "minimum": 2, "maximum": 300},
    "library_wiki_vector_search_enabled": {"type": "boolean"},
    "library_wiki_vector_index_min_pages": {"type": "integer", "minimum": 1},
    "library_wiki_vector_search_weight": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "additionalProperties": false
}
