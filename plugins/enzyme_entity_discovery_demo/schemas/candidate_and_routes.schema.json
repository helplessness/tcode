{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tcode:enzyme-entity-demo:schema:candidate-and-routes:1.0",
  "type": "object",
  "required": ["schema_version", "run_id", "baseline_candidate_draft", "entity_expanded_candidates", "comparison_notes", "routes", "route_planning_status", "route_gaps", "published_ontology_modified"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string"},
    "baseline_candidate_draft": {"type": "array"},
    "entity_expanded_candidates": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["candidate_id", "candidate_kind", "label", "entity_id", "proposal_id", "evidence_level", "source_fact_scope", "fit_reason", "supporting_assertion_ids", "supporting_evidence_ids", "conflicts", "knowledge_gaps", "target_activity_status"],
        "properties": {
          "candidate_id": {"type": "string"},
          "candidate_kind": {"enum": ["entity_protein", "entity_protein_group", "entity_family", "model_candidate", "unmatched_capability"]},
          "candidate_role": {"enum": ["primary", "route_component", "diagnostic_control", "family_hint", "unmatched_capability"]},
          "group_rank": {"type": "integer", "minimum": 1},
          "label": {"type": "string", "minLength": 1},
          "entity_id": {"type": ["string", "null"]},
          "proposal_id": {"type": ["string", "null"]},
          "evidence_level": {"enum": ["mechanistic_analogy", "model_background_unverified"]},
          "source_fact_scope": {"enum": ["reported_exact", "reported_related", "none"]},
          "fit_reason": {"type": "string", "minLength": 1},
          "supporting_assertion_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "supporting_evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "conflicts": {"type": "array", "items": {"type": "string"}},
          "knowledge_gaps": {"type": "array", "items": {"type": "string"}},
          "target_activity_status": {"const": "hypothesis_unvalidated"}
        },
        "additionalProperties": false
      }
    },
    "comparison_notes": {"type": "array", "items": {"type": "string"}},
    "routes": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["route_id", "title", "route_kind", "reported_path", "hypothetical_steps", "closure_checks", "auxiliary_steps", "validation_priority", "target_pathway_status"],
        "properties": {
          "route_id": {"type": "string"},
          "title": {"type": "string", "minLength": 1},
          "route_kind": {"enum": ["reported_path_hypothesis", "hybrid_path_hypothesis", "model_path_hypothesis"]},
          "reported_path": {"type": ["object", "null"]},
          "hypothetical_steps": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "required": ["step_id", "description", "input_labels", "output_labels", "candidate_ids", "evidence_level", "knowledge_gaps", "target_activity_status"],
              "properties": {
                "step_id": {"type": "string"},
                "description": {"type": "string", "minLength": 1},
                "input_labels": {"type": "array", "items": {"type": "string"}},
                "output_labels": {"type": "array", "items": {"type": "string"}},
                "candidate_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
                "evidence_level": {"enum": ["mechanistic_analogy", "model_background_unverified"]},
                "knowledge_gaps": {"type": "array", "items": {"type": "string"}},
                "target_activity_status": {"const": "hypothesis_unvalidated"}
              },
              "additionalProperties": false
            }
          },
          "closure_checks": {
            "type": "array",
            "minItems": 7,
            "maxItems": 7,
            "items": {
              "type": "object",
              "required": ["check_id", "status", "finding"],
              "properties": {
                "check_id": {"enum": ["material_handoff", "direction", "cofactor_resource", "energy_balance", "byproduct_control", "condition_compatibility", "intermediate_stability"]},
                "status": {"enum": ["pass", "gap", "unknown", "not_applicable"]},
                "finding": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          },
          "auxiliary_steps": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "required": ["auxiliary_id", "function", "description", "required_status", "evidence_level"],
              "properties": {
                "auxiliary_id": {"type": "string"},
                "function": {"enum": ["cofactor_supply_or_regeneration", "energy_supply_or_regeneration", "byproduct_mitigation", "intermediate_protection", "condition_staging", "other"]},
                "description": {"type": "string", "minLength": 1},
                "required_status": {"enum": ["required", "optional", "unknown"]},
                "evidence_level": {"const": "model_background_unverified"}
              },
              "additionalProperties": false
            }
          },
          "validation_priority": {"type": "string", "minLength": 1},
          "target_pathway_status": {"const": "hypothesis_unvalidated"}
        },
        "additionalProperties": false
      }
    },
    "route_planning_status": {"enum": ["completed_with_hypotheses", "no_local_route"]},
    "route_gaps": {"type": "array", "items": {"type": "string"}},
    "published_ontology_modified": {"const": false}
    ,"reasoning_protocol": {"type": "string"}
    ,"knowledge_backend": {"const": "ontology_assertion_evidence"}
    ,"ranking_policy": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
