{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tcode:enzyme-entity-demo:schema:baseline-candidate-draft:1.0",
  "type": "object",
  "required": ["schema_version", "run_id", "baseline_candidate_draft", "entity_references_present"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string"},
    "baseline_candidate_draft": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["proposal_id", "label", "identity_level", "fit_reason", "knowledge_gaps", "evidence_level", "frozen_before_entity_candidate_lookup"],
        "properties": {
          "proposal_id": {"type": "string"},
          "label": {"type": "string", "minLength": 1},
          "identity_level": {"enum": ["protein", "named_enzyme", "family", "capability_gap"]},
          "fit_reason": {"type": "string", "minLength": 1},
          "knowledge_gaps": {"type": "array", "items": {"type": "string"}},
          "evidence_level": {"const": "model_background_unverified"},
          "frozen_before_entity_candidate_lookup": {"const": true}
        },
        "additionalProperties": false
      }
    },
    "entity_references_present": {"const": false}
  },
  "additionalProperties": false
}
