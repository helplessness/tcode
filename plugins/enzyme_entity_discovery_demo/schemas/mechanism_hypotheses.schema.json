{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tcode:enzyme-entity-demo:schema:mechanism-hypotheses:1.0",
  "$defs": {
    "claim": {
      "type": "object",
      "required": ["claim_id", "text", "evidence_level", "assertion_ids", "evidence_ids", "scope_or_method"],
      "properties": {
        "claim_id": {"type": "string"},
        "text": {"type": "string", "minLength": 1},
        "evidence_level": {"enum": ["reported_exact", "reported_related", "mechanistic_analogy", "computed_prediction", "model_background_unverified"]},
        "assertion_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "scope_or_method": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["schema_version", "run_id", "bundle_digest", "hypotheses", "global_knowledge_gaps", "published_ontology_modified"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string"},
    "bundle_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["hypothesis_id", "title", "proposed_mechanism", "required_capability_ids", "required_cofactor_ids", "intermediate_ids", "fact_claims", "analogy_claims", "prediction_claims", "counterarguments", "evidence_gaps", "falsification_tests", "counterfactual_bridge", "target_activity_status"],
        "properties": {
          "hypothesis_id": {"type": "string"},
          "title": {"type": "string", "minLength": 1},
          "proposed_mechanism": {"type": "string", "minLength": 1},
          "required_capability_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "required_cofactor_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "intermediate_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "fact_claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
          "analogy_claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
          "prediction_claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
          "counterarguments": {"type": "array", "items": {"type": "string"}},
          "evidence_gaps": {"type": "array", "items": {"type": "string"}},
          "falsification_tests": {"type": "array", "items": {"type": "string"}},
          "counterfactual_bridge": {
            "type": "object",
            "required": ["shared_events", "missing_events", "conflicting_events", "native_termination", "target_alternative_termination", "unsupported_assumptions", "target_activity_status", "source"],
            "properties": {
              "shared_events": {"type": "array", "items": {"type": "string"}},
              "missing_events": {"type": "array", "items": {"type": "string"}},
              "conflicting_events": {"type": "array", "items": {"type": "string"}},
              "native_termination": {"type": "array", "items": {"type": "string"}},
              "target_alternative_termination": {"type": "array", "items": {"type": "string"}},
              "unsupported_assumptions": {"type": "array", "items": {"type": "string"}},
              "target_activity_status": {"const": "hypothesis_unvalidated"},
              "source": {"enum": ["explicit_alignment", "legacy_derived"]}
            },
            "additionalProperties": false
          },
          "target_activity_status": {"const": "hypothesis_unvalidated"}
        },
        "additionalProperties": false
      }
    },
    "global_knowledge_gaps": {"type": "array", "items": {"type": "string"}},
    "published_ontology_modified": {"const": false}
    ,"reasoning_protocol": {"type": "string"}
    ,"knowledge_backend": {"const": "ontology_assertion_evidence"}
  },
  "additionalProperties": false
}
