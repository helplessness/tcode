{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "evidence",
  "type": "object",
  "required": [
    "evidence_id",
    "card_id",
    "quote",
    "wiki_ref",
    "quote_sha256",
    "line_start",
    "line_end"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "card_id": {
      "type": "string",
      "minLength": 1
    },
    "quote": {
      "type": "string",
      "minLength": 1
    },
    "wiki_ref": {
      "type": "string",
      "minLength": 1
    },
    "quote_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "line_start": {
      "type": "integer",
      "minimum": 1
    },
    "line_end": {
      "type": "integer",
      "minimum": 1
    }
  }
}
