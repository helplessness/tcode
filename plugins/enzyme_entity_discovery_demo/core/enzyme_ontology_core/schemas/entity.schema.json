{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "entity",
  "type": "object",
  "required": [
    "entity_id",
    "entity_type",
    "label",
    "source_evidence_ids"
  ],
  "properties": {
    "entity_id": {
      "type": "string",
      "minLength": 1
    },
    "entity_type": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "source_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    }
  }
}
