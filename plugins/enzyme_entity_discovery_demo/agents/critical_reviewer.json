  "prompt": "prompts/critical_reviewer.md",
  "options": {
    "display_name": "实体 Demo 批判审核师",
    "max_tool_calls_per_turn": 16,
    "reasoning_effort": "low",
    "max_output_tokens": 12288
  },
  "steps": 8
}
