{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "knowledge_format": {
      "type": "string",
      "enum": [
        "sqlite"
      ],
      "default": "sqlite",
      "description": "实体事实从本地只读 SQLite 查询。"
    },
    "offline_mode": {
      "type": "boolean",
      "const": true,
      "default": true
    },
    "workspace_dir": {
      "type": "string",
      "enum": [
        ".tcode/plugins/enzyme_entity_discovery_demo"
      ],
      "default": ".tcode/plugins/enzyme_entity_discovery_demo"
    },
    "max_results": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50,
      "default": 20
    },
    "audit_log_max_records": {
      "type": "integer",
      "minimum": 100,
      "maximum": 5000,
      "default": 1000
    },
    "max_hypotheses": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8,
      "default": 4
    },
    "max_candidates": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16,
      "default": 10
    },
    "expected_bundle_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
