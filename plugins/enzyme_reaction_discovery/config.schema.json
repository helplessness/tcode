{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "workspace_dir": {
      "type": "string",
      "default": "./.tcode/plugins/enzyme_reaction_discovery"
    },
    "offline_mode": {
      "const": true,
      "default": true
    },
    "retrieval": {
      "type": "object",
      "properties": {
        "mode": {"enum": ["hybrid", "lexical"], "default": "hybrid"},
        "batch_size": {"type": "integer", "minimum": 1, "maximum": 16, "default": 8},
        "build_batches": {"type": "integer", "minimum": 1, "maximum": 8, "default": 4},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 60, "default": 30},
        "min_similarity": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.25},
        "allow_runtime_build": {"const": false, "default": false, "description": "聊天不构建文档向量；使用管理员索引维护命令预建。"}
      },
      "additionalProperties": false
    },
    "max_route_steps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8,
      "default": 8
    }
  },
  "additionalProperties": false
}
