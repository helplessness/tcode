{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tcode.local/enzyme-reaction-discovery/capability-mapping-v1.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "evidence_ledger",
    "catalytic_capabilities",
    "cofactor_candidates"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ledger": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidenceStatement"
      }
    },
    "catalytic_capabilities": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "capability_id",
          "description",
          "supports_hypotheses",
          "support_refs",
          "contradiction_refs"
        ],
        "properties": {
          "capability_id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "supports_hypotheses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "support_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "contradiction_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "unknown_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required_features": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "negative_features": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "cofactor_candidates": {
      "type": "array",
      "minItems": 0,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "rank",
          "cofactor_class",
          "supports",
          "contradictions",
          "confidence"
        ],
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "cofactor_class": {
            "type": "string",
            "minLength": 1
          },
          "supports": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "contradictions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "unknowns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low",
              "unresolved"
            ]
          },
          "evidence_basis": {
            "enum": [
              "wiki_analogy",
              "model_hypothesis"
            ]
          },
          "verification_note": {
            "type": "string",
            "minLength": 1
          },
          "mechanism_ids": {
            "type": "array",
            "maxItems": 10,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^M(?:10|[1-9])$"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "evidenceStatement": {
      "type": "object",
      "required": [
        "statement_id",
        "kind",
        "statement",
        "source_refs"
      ],
      "properties": {
        "statement_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "fact",
            "inference",
            "hypothesis",
            "counterevidence",
            "unknown"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "card_id": {
          "type": "string"
        },
        "field_path": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
