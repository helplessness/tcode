{"$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://tcode.local/enzyme-reaction-discovery/critique-v1.schema.json", "type": "object", "required": ["schema_version", "run_id", "evidence_ledger", "review_decision", "critique"], "properties": {"schema_version": {"const": "1.0"}, "audited_upstream_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "run_id": {"type": "string", "minLength": 1}, "evidence_ledger": {"type": "array", "items": {"$ref": "#/$defs/evidenceStatement"}}, "review_decision": {"enum": ["PASS", "PARTIAL_PASS", "REVISE"]}, "review_summary": {"type": "object", "properties": {"objects": {"type": "array", "maxItems": 100, "items": {"type": "object", "required": ["object_id", "object_type", "assessment", "ranking", "status"], "properties": {"object_id": {"type": "string"}, "object_type": {"enum": ["candidate", "mechanism", "route"]}, "name": {"type": "string"}, "assessment": {"enum": ["unreviewed", "retained", "revise", "excluded"]}, "ranking": {"enum": ["clear", "pending"]}, "status": {"enum": ["retained", "unreviewed", "needs_revision", "excluded"]}, "depends_on": {"type": "array", "items": {"type": "string"}}, "affected_by": {"type": "array", "items": {"type": "string"}}, "reasons": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}}, "retained_route_ids": {"type": "array", "items": {"type": "string"}}, "pending_ids": {"type": "array", "items": {"type": "string"}}, "global_reasons": {"type": "array", "items": {"type": "string"}}, "can_partially_deliver": {"type": "boolean"}, "partial_delivery_blocked": {"type": "string"}}, "additionalProperties": false}, "requested_review_decision": {"enum": ["PASS", "PARTIAL_PASS", "REVISE"]}, "critique": {"type": "object", "required": ["hard_conflicts", "evidence_gaps", "route_dispositions", "required_revisions"], "properties": {"mechanism_reviews": {"type": "array", "maxItems": 30, "items": {"type": "object", "required": ["hypothesis_id", "disposition", "reason", "evidence_refs"], "properties": {"hypothesis_id": {"type": "string", "minLength": 1}, "disposition": {"enum": ["retain", "demote", "revise", "exclude"]}, "reason": {"type": "string", "minLength": 1, "maxLength": 500}, "evidence_refs": {"type": "array", "maxItems": 8, "items": {"type": "string"}}}, "additionalProperties": false}}, "candidate_reviews": {"type": "array", "maxItems": 30, "items": {"type": "object", "required": ["candidate_id", "disposition", "reason", "evidence_refs"], "properties": {"candidate_id": {"type": "string", "minLength": 1}, "disposition": {"enum": ["retain", "demote", "revise", "exclude"]}, "reason": {"type": "string", "minLength": 1, "maxLength": 500}, "evidence_refs": {"type": "array", "maxItems": 8, "items": {"type": "string"}}}, "additionalProperties": false}}, "excluded_candidate_ids": {"type": "array", "maxItems": 10, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "excluded_mechanism_ids": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "revision_proposal_checks": {"type": "array", "maxItems": 15, "items": {"type": "object", "required": ["route_id", "check", "original_instruction", "execution_status"]}}, "revision_policy_checks": {"type": "array", "maxItems": 5, "items": {"type": "object", "required": ["task_index", "affected_ids", "original_instruction", "rule", "execution_status"]}}, "hard_conflicts": {"type": "array", "items": {"$ref": "#/$defs/reviewIssue"}}, "evidence_gaps": {"type": "array", "items": {"$ref": "#/$defs/reviewIssue"}}, "route_dispositions": {"type": "array", "items": {"type": "object", "required": ["route_id", "disposition", "reason", "evidence_refs"], "properties": {"route_id": {"type": "string", "minLength": 1}, "disposition": {"enum": ["retain", "demote", "exclude", "revise"]}, "reason": {"type": "string", "minLength": 1}, "evidence_refs": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}}, "required_revisions": {"type": "array", "items": {"type": "string"}}, "revision_tasks": {"type": "array", "maxItems": 5, "items": {"type": "object", "required": ["scope", "affected_ids", "instruction"], "properties": {"scope": {"enum": ["reaction", "mechanism", "screening", "audit", "delivery"]}, "affected_ids": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 160}}, "instruction": {"type": "string", "minLength": 1, "maxLength": 800}, "balance_proposals": {"type": "object", "maxProperties": 3, "additionalProperties": {"$ref": "#/$defs/stoichiometry"}}}, "additionalProperties": false}}}, "additionalProperties": false}, "audited_policy_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false, "$defs": {"stoichiometry": {"type": "object", "required": ["species", "steps"], "properties": {"species": {"type": "object", "minProperties": 1, "maxProperties": 40, "propertyNames": {"minLength": 1, "maxLength": 80}, "additionalProperties": {"type": "string", "maxLength": 256}}, "charges": {"type": "object", "maxProperties": 40, "additionalProperties": {"type": "integer", "minimum": -100, "maximum": 100}}, "steps": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "object", "minProperties": 1, "maxProperties": 40, "additionalProperties": {"type": "number", "minimum": -1000000, "maximum": 1000000}}}, "net": {"type": "object", "minProperties": 1, "maxProperties": 40, "additionalProperties": {"type": "number", "minimum": -1000000, "maximum": 1000000}}, "basis": {"type": "string", "maxLength": 600}}, "additionalProperties": false, "description": "可选计量账本。species 是稳定物种名到分子式的映射，未知分子式用空串；steps 按路线顺序给各物种有符号系数（消耗负、生成正），net 可给总反应。charges 仅填写确知的电荷。不填写不代表配平，程序不推测或自动修改系数。"}, "evidenceStatement": {"type": "object", "required": ["statement_id", "kind", "statement", "source_refs"], "properties": {"statement_id": {"type": "string", "minLength": 1}, "kind": {"enum": ["fact", "inference", "hypothesis", "counterevidence", "unknown"]}, "statement": {"type": "string", "minLength": 1}, "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "card_id": {"type": "string"}, "field_path": {"type": "string"}}, "additionalProperties": false}, "reviewIssue": {"type": "object", "required": ["issue_id", "severity", "statement", "affected_ids", "evidence_refs"], "properties": {"issue_id": {"type": "string", "minLength": 1}, "issue_type": {"enum": ["chemical_conflict", "overstatement", "evidence_attribution", "ranking_inconsistency", "evidence_gap", "audit_delivery"]}, "severity": {"enum": ["critical", "major", "minor"]}, "statement": {"type": "string", "minLength": 1}, "affected_ids": {"type": "array", "items": {"type": "string"}}, "evidence_refs": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}}}
