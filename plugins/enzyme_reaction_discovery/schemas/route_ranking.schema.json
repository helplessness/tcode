  "$defs": {
    "stepEquation": {"type":"object","required":["species","coefficients"],"properties":{"species":{"type":"object","minProperties":1,"maxProperties":40,"propertyNames":{"minLength":1,"maxLength":80},"additionalProperties":{"type":"string","maxLength":256}},"coefficients":{"type":"object","minProperties":1,"maxProperties":40,"additionalProperties":{"type":"number","minimum":-1000000,"maximum":1000000}},"charges":{"type":"object","maxProperties":40,"additionalProperties":{"type":"integer","minimum":-100,"maximum":100}}},"additionalProperties":false,"description":"本步骤计量：species 为稳定物种名到分子式（未知为空串）；coefficients 为消耗负、生成正的系数，charges 仅填写已知电荷。跨步骤同物种同名。程序仅相加，不自动配平。"},

    "stoichiometry": {"type":"object","required":["species","steps"],"properties":{"species":{"type":"object","minProperties":1,"maxProperties":40,"propertyNames":{"minLength":1,"maxLength":80},"additionalProperties":{"type":"string","maxLength":256}},"charges":{"type":"object","maxProperties":40,"additionalProperties":{"type":"integer","minimum":-100,"maximum":100}},"steps":{"type":"array","minItems":1,"maxItems":8,"items":{"type":"object","minProperties":1,"maxProperties":40,"additionalProperties":{"type":"number","minimum":-1000000,"maximum":1000000}}},"net":{"type":"object","minProperties":1,"maxProperties":40,"additionalProperties":{"type":"number","minimum":-1000000,"maximum":1000000}},"basis":{"type":"string","maxLength":600}},"additionalProperties":false,"description":"可选计量账本。species 是稳定物种名到分子式的映射，未知分子式用空串；steps 按路线顺序给各物种有符号系数（消耗负、生成正），net 可给总反应。charges 仅填写确知的电荷。不填写不代表配平，程序不推测或自动修改系数。"},
