{
  "name": "tcode-agent-web",
  "version": "0.0.3-alpha.1",
  "description": "Web interface for Tcode Agent",
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-molstar.mjs",
    "prebuild": "node scripts/prepare-molstar.mjs",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "generate:protocol": "python ../scripts/generate_web_protocol.py",
    "check:protocol": "python ../scripts/generate_web_protocol.py --check",
    "check:protocol-types": "tsc --noEmit -p tsconfig.protocol.json",
    "check:stage4": "npm run check:protocol && npm run check:protocol-types",
    "preview": "vite preview",
    "test": "vitest run --environment node"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.59",
    "@ag-ui/core": "0.0.59",
    "@antv/g6": "^5.1.1",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@mcp-ui/client": "7.1.1",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@open-file-viewer/core": "0.1.48",
    "dompurify": "^3.4.17",
    "gifenc": "1.0.3",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.22",
    "marked": "^16.4.0",
    "mermaid": "^11.12.0",
    "molstar": "5.11.0",
    "solid-js": "^1.9.5",
    "three": "0.184.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.15",
    "@types/node": "24.3.0",
    "@types/three": "0.184.1",
    "autoprefixer": "^10.4.20",
    "daisyui": "^5.3.7",
    "tailwindcss": "^4.1.15",
    "typescript": "^5.6.2",
    "vite": "6.4.3",
    "vite-plugin-solid": "^2.11.9",
    "vitest": "^3.2.6"
  }
}
