{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "required": ["version", "targets"], "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "targets": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/target"}}
  },
  "$defs": {
    "name": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
    "target": {
      "type": "object", "required": ["id", "connection", "execution", "tools"], "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
        "dynamic_headers": {"type": "object", "maxProperties": 32, "additionalProperties": {"type": "object",
          "required": ["variable", "description"], "additionalProperties": false,
          "properties": {"variable": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"},
            "description": {"type": "string", "minLength": 1, "maxLength": 1000},
            "extraction_hint": {"type": "string", "maxLength": 1000}, "required": {"type": "boolean"},
            "max_length": {"type": "integer", "minimum": 1, "maximum": 4096}}}},
        "connection": {"type": "object", "required": ["urlConfig"], "additionalProperties": false,
          "properties": {"transport": {"const": "streamable-http"}, "urlConfig": {"$ref": "#/$defs/name"}, "bearerTokenConfig": {"$ref": "#/$defs/name"}}},
        "execution": {"type": "object", "required": ["mode"], "additionalProperties": false,
          "properties": {"mode": {"enum": ["blocking", "remote-job"]},
            "submitTool": {"$ref": "#/$defs/name"}, "statusTool": {"$ref": "#/$defs/name"},
            "resultTool": {"$ref": "#/$defs/name"}, "cancelTool": {"$ref": "#/$defs/name"}},
          "if": {"properties": {"mode": {"const": "remote-job"}}},
          "then": {"required": ["submitTool", "statusTool", "resultTool", "cancelTool"]}},
        "tools": {"type": "array", "minItems": 1, "maxItems": 100, "items": {
          "type": "object", "required": ["name", "inputSchema", "output"], "additionalProperties": false,
          "properties": {
            "name": {"$ref": "#/$defs/name"}, "summary": {"type": "string", "maxLength": 2000}, "skill": {"type": "string"},
            "argumentStyle": {"enum": ["flat", "input_config"]}, "inputSchema": {"type": "object"},
            "files": {"type": "array", "maxItems": 100, "items": {"type": "object", "required": ["pointer", "kind", "transport"], "additionalProperties": false,
              "properties": {"pointer": {"type": "string", "pattern": "^/", "maxLength": 1024}, "kind": {"enum": ["file", "directory"]}, "transport": {"const": "artifact"}}}},
            "output": {"type": "object", "required": ["contract"], "additionalProperties": false, "properties": {"contract": {"const": "artifact-bundle-v1"}}}
          }
        }}
      }
    }
  }
}
