{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "review-decision",
  "type": "object",
  "required": [
    "batch_id",
    "decision",
    "reviewer_user_id",
    "payload_hash"
  ],
  "properties": {
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "const": "preserve_legacy"
    },
    "reviewer_user_id": {
      "type": "null"
    },
    "payload_hash": {
      "type": "string",
      "minLength": 1
    }
  }
}
