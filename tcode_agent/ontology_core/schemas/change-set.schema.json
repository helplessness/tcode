{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "change-set",
  "type": "object",
  "required": [
    "schema_version",
    "batch_id",
    "scope",
    "workspace_id",
    "provenance",
    "decision",
    "reviewer_user_id",
    "files",
    "baseline",
    "legacy_manifest",
    "payload_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "const": "public"
    },
    "workspace_id": {
      "type": "null"
    },
    "provenance": {
      "const": "legacy_curated"
    },
    "decision": {
      "const": "preserve_legacy"
    },
    "reviewer_user_id": {
      "type": "null"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "baseline": {
      "type": "object"
    },
    "legacy_manifest": {
      "type": "object"
    },
    "payload_hash": {
      "type": "string",
      "minLength": 1
    }
  }
}
