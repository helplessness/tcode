{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "extracted-span",
  "type": "object",
  "required": [
    "span_id",
    "source_id",
    "revision",
    "text",
    "text_sha256",
    "line_start",
    "line_end"
  ],
  "properties": {
    "span_id": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "text_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "line_start": {
      "type": "integer",
      "minimum": 1
    },
    "line_end": {
      "type": "integer",
      "minimum": 1
    }
  }
}
